{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // EF logs EVERY executed statement at Information, with the full formatted SQL after it. The
      // template dampens Microsoft.AspNetCore and misses this one, so it inherits Default and the
      // session read alone — a join over Sessions/Players/Cards/Techs/Objectives/Scores/Votes — runs
      // to ~30 lines, and a request costs ~80. Measured live: 22k statements = ~210k lines = ~100 MB of
      // journal PER DAY, which had eaten 1.2 GB and left 28 h of retention. Warning, everywhere:
      // in Development the same wall of SQL buries anything worth reading in the F5 console.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ti4db": "Data Source=ti4.db",
    "ti4masterdb": "Data Source=ti4master.db"
  },
  "Ti4": {
    "DefaultRetentionHours": 2160,
    "PausedRetentionHours": 8760,
    // Non-empty => every screen carries a permanent badge with this text. Empty on production; the
    // staging unit sets Ti4__InstanceLabel=TEST so a test game can't be mistaken for a real one.
    "InstanceLabel": ""
  }
}
