.env
.env.local
*.env.local

# Local tool config
.claude/

# OS / editor cruft
Thumbs.db
.DS_Store
*.swp

# Logs / temp
*.log
_secrets.txt
_tmp*

# Local-only source assets — kept OUT of the repo (large binaries + licensed/copyrighted material):
# GIMP card-art templates (~69 MB), commercial fonts (Myriad Pro/Adobe, Handel Gothic),
# faction source art, and photos of the physical FFG cards (all FFG-copyrighted).
# These live on the dev machine only.
/xcf/
/Resources/
/References/
