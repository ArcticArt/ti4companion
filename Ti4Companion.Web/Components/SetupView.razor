@inherits Ti4ComponentBase

@*
    Setup, walked through in order: name → variant and options → players → seating and speaker → objectives.
    It used to be every panel at once, which said nothing about what to do first.

    Only the HOST is stepped. Everyone else always sees the player list, because a joiner has to be able to
    pick their faction and colour and ready up whenever they arrive — waiting for the host to be on the right
    step would be absurd. The strip is clickable for the host, so nothing is ever more than one tap away
    (and a reload, which forgets the step, costs nothing).
*@
@{
    var s = Store.Session!;
    var ordered = s.Players.OrderBy(p => p.SeatOrder).ToList();
    var host = Store.IsHost;
    // Non-hosts only ever see the player step.
    var step = host ? current : SetupStep.Players;
}

@if (host)
{
    <div class="panel status-stagebar setup-steps">
        <div class="stage-strip">
            @foreach (var (st, key) in Steps)
            {
                <button class="stage-seg @(step == st ? "on" : step > st ? "done" : "")" @onclick="() => current = st">@Loc[key]</button>
            }
        </div>
        <div class="spacer" style="flex:1"></div>
        <div class="stage-nav">
            @if (step > SetupStep.Name)
            {
                <button class="btn btn-sm" @onclick="() => current = step - 1">◂ @Loc["common.back"]</button>
            }
            @if (step < SetupStep.Objectives)
            {
                <button class="btn btn-sm btn-gold" @onclick="() => current = step + 1">@Loc["status.next"] ▸</button>
            }
        </div>
    </div>
}

@* ---- Step 1: what is this game called (and which expansions are in) ---- *@
@if (step == SetupStep.Name)
{
    <div class="panel" style="margin-top:.6rem;">
        <h3 style="margin:0 0 .2rem;">@Loc["setup.step.name"]</h3>
        <p class="faint" style="margin:0 0 .6rem;">@Loc["setup.nameHint"]</p>
        <input type="text" value="@s.Name" @onchange="SetName" placeholder="@NamePlaceholder" style="max-width:24rem;" />
        <div style="margin-top:.8rem;">
            <label>@Loc["home.expansions"]</label>
            <div class="row-wrap" style="gap:.4rem;margin-top:.3rem;">
                @foreach (var x in new[] { Expansion.ProphecyOfKings, Expansion.Codex, Expansion.ThundersEdge })
                {
                    var on = s.ActiveExpansions.HasFlag(x);
                    <button class="btn btn-sm @(on ? "btn-gold" : "btn-ghost")" @onclick="() => ToggleExpansion(x)">@Loc[$"exp.{x}"]</button>
                }
            </div>
            <span class="faint go-hint">@Loc["setup.expansionsHint"]</span>
        </div>
    </div>
}

@* ---- Step 3: the players (and the only thing a non-host sees) ---- *@
@if (step == SetupStep.Players)
{
<div class="panel">
    <h3>@Loc["setup.title"]</h3>
    <p class="faint">@(host ? Loc["setup.startHint"] : Loc["setup.waiting"])</p>

    <div class="grid" style="gap:.7rem;">
        @for (var i = 0; i < ordered.Count; i++)
        {
            var p = ordered[i];
            var idx = i;
            var fac = Store.Faction(p.FactionId);
            var editable = Store.CanEdit(p.Id);
            var isSpeaker = s.SpeakerPlayerId == p.Id;
            <div class="player-card" style="--player-color:@p.ColorHex;flex-direction:column;align-items:stretch;gap:.5rem;">
                <div class="setup-pcard-head">
                    <div class="setup-pcard-id">
                        @if (host)
                        {
                            <span class="seat-no">@(idx + 1)</span>
                            <span class="seat-btns">
                                <button class="btn btn-sm btn-ghost" title="@Loc["setup.moveUp"]" disabled="@(idx == 0)" @onclick="() => MoveSeat(idx, -1)">▲</button>
                                <button class="btn btn-sm btn-ghost" title="@Loc["setup.moveDown"]" disabled="@(idx == ordered.Count - 1)" @onclick="() => MoveSeat(idx, 1)">▼</button>
                            </span>
                        }
                        <FactionBadge Faction="fac" Ring="@p.ColorHex" />
                        <div class="setup-pcard-name">
                            @if (editable)
                            {
                                <input type="text" value="@p.Name" @onchange="e => SetName(p.Id, e)" />
                            }
                            else
                            {
                                <strong>@p.Name</strong>
                            }
                        </div>
                    </div>
                    <div class="setup-pcard-ctrls">
                        @if (p.Id == Store.MyPlayerId) { <span class="chip">@Loc["players.you"]</span> }
                        @if (p.IsHost) { <span class="chip chip-active">@Loc["host.only"]</span> }
                        <button class="btn btn-sm @(isSpeaker ? "btn-gold" : "")" disabled="@(!host)" @onclick="() => SetSpeaker(p.Id)" title='@Loc["setup.makeSpeaker"]'>
                            @if (isSpeaker) { <SpeakerIcon SizeCss="1.3em" /> } else { @Loc["setup.makeSpeaker"] }
                        </button>
                        <span class="chip @(p.IsReady ? "chip-done" : "")">@(p.IsReady ? Loc["setup.ready"] : Loc["setup.notReady"])</span>
                        @if (host && p.Id != Store.MyPlayerId)
                        {
                            <button class="btn btn-sm btn-ghost" @onclick="() => Remove(p.Id)" title="@Loc["players.remove"]">✕</button>
                        }
                    </div>
                </div>

                @if (editable)
                {
                    <div>
                        <label>@Loc["setup.chooseFaction"]</label>
                        <FactionPicker Factions="Store.ActiveFactions()" Current="@p.FactionId" Taken="@TakenFactions(p.Id)" OnPick="id => SetFactionId(p.Id, id)" />
                    </div>
                    <div>
                        <label>@Loc["setup.chooseColor"]</label>
                        <PlayerColorPicker Current="@p.ColorHex" OnPick="hex => SetColor(p.Id, hex)" TakenByResolver="hex => TakenBy(hex, p.Id)" />
                    </div>
                    var canReady = !string.IsNullOrEmpty(p.FactionId) && Ti4Colors.IsChosen(p.ColorHex);
                    <div>
                        <button class="btn btn-sm @(p.IsReady ? "" : "btn-gold")" disabled="@(!canReady)"
                                @onclick="() => SetReady(p.Id, !p.IsReady)">
                            @(p.IsReady ? Loc["setup.notReady"] : Loc["setup.imReady"])
                        </button>
                        @if (!canReady && !p.IsReady)
                        {
                            <div class="faint" style="font-size:.72rem;margin-top:.2rem;">@Loc["setup.needFactionColor"]</div>
                        }
                    </div>
                }
                else
                {
                    <div class="faint" style="font-size:.8rem;">@(fac is null ? "—" : Loc.Pick(fac.Name, fac.NameDe)) · @Loc["players.editLocked"]</div>
                }
            </div>
        }
    </div>

    @* Max 8 players: hide the add control once full. *@
    @if (host && ordered.Count < 8)
    {
        <div style="display:flex;gap:.5rem;margin-top:1rem;">
            <input type="text" @bind="newName" placeholder="@AddPlaceholder" style="max-width:240px;" />
            <button class="btn btn-primary" @onclick="Add">+ @Loc["players.add"]</button>
        </div>
    }
    else if (host)
    {
        <p class="faint" style="margin-top:1rem;">@Loc["setup.maxPlayers"]</p>
    }
</div>
}

@* ---- Step 4: seating order and the speaker ---- *@
@if (step == SetupStep.Seating)
{
    <div class="panel" style="margin-top:.6rem;">
        <h3 style="margin:0 0 .2rem;">@Loc["setup.step.seating"]</h3>
        <p class="faint" style="margin:0 0 .6rem;">@Loc["setup.seatingHint"]</p>
        <SeatOrderList />
    </div>
}

@* ---- Step 2: the table's variant and options ---- *@
@if (step == SetupStep.Options)
{
    <div class="panel" style="margin-top:.6rem;">
        <h3 style="margin:0 0 .6rem;">@Loc["options.title"]</h3>

        <div class="game-option">
            <label for="cardsPerPlayer">@Loc["cards.perPlayer"]</label>
            <select id="cardsPerPlayer" value="@Store.Session!.StrategyCardsPerPlayer" @onchange="SetCardsPerPlayer">
                <option value="0">@Loc["cards.auto"]</option>
                <option value="1">1</option>
                <option value="2">2</option>
            </select>
            <span class="faint go-hint">@Loc["cards.hint"]</span>
        </div>

        <div class="game-option">
            <label for="turnTimer">@Loc["timer.title"] — @Loc["timer.perRound"]</label>
            <select id="turnTimer" value="@Store.Session!.TurnTimerSeconds" @onchange="SetTurnTimer">
                <option value="0">@Loc["timer.off"]</option>
                @foreach (var min in new[] { 5, 8, 10, 12, 15, 20, 30 })
                {
                    <option value="@(min * 60)">@min min</option>
                }
            </select>
            <span class="faint go-hint">@Loc["timer.hint"]</span>
        </div>

        @* Red Tape: two published community variants (see RedTapeVariant). Both put tape on the public
           objectives and hand the removal to one strategy card, so the table also picks which card carries
           it — the variant replaces either Diplomacy or Imperial. *@
        <div class="game-option">
            <label for="redTape">@Loc["redtape.title"]</label>
            <select id="redTape" value="@((int)Store.Session!.RedTapeVariant)" @onchange="SetRedTapeVariant">
                <option value="0">@Loc["redtape.off"]</option>
                <option value="1">@Loc["redtape.bureaucracy"]</option>
                <option value="2">@Loc["redtape.lite"]</option>
            </select>
            <span class="faint go-hint">@Loc[Store.Session!.RedTapeVariant switch
                {
                    RedTapeVariant.Bureaucracy => "redtape.bureaucracyHint",
                    RedTapeVariant.Lite => "redtape.liteHint",
                    _ => "redtape.hint",
                }]</span>
        </div>

        @if (Store.RedTapeOn)
        {
            <div class="game-option">
                <label for="redTapeCard">@Loc["redtape.card"]</label>
                <select id="redTapeCard" value="@Store.Session!.RedTapeCardNumber" @onchange="SetRedTapeCard">
                    @foreach (var n in new[] { GameRules.RedTapeDiplomacyCard, GameRules.ImperialStrategyCard })
                    {
                        var card = Store.Card(n);
                        <option value="@n">@n — @(card is null ? "" : Loc.Pick(card.Name, card.NameDe))</option>
                    }
                </select>
                <span class="faint go-hint">@Loc["redtape.cardHint"]</span>
            </div>
        }

        <div class="game-option">
            <label class="go-check">
                <input type="checkbox" id="promptTech" checked="@Store.Session!.PromptTechOnAction" @onchange="SetPromptTech" />
                @Loc["tech.promptOption"]
            </label>
            <span class="faint go-hint">@Loc["tech.promptHint"]</span>
        </div>
    </div>
}

@* ---- Step 5: record the objectives the table drew ---- *@
@if (step == SetupStep.Objectives)
{
    <div class="panel" style="margin-top:.6rem;">
        <h3 style="margin:0 0 .2rem;">@Loc["setup.objectives"]</h3>
        <p class="faint" style="margin:0 0 .6rem;">@Loc[Store.RedTapeOn ? "setup.objectivesHintRedTape" : "setup.objectivesHint"]</p>
        <ObjectivesTab RevealOnTop="true" Scoreable="false" AllowCustom="false" />
    </div>
}

@code {
    private Guid Sid => Store.Session!.Id;
    private string newName = "";
    private string AddPlaceholder => Loc["players.add"];
    private string NamePlaceholder => Loc["home.sessionName"];

    /// <summary>The order the table settles things in. Host-local: it steers this device's view and nothing
    /// else, so it needs no session state and a reload just lands on the first step.</summary>
    private enum SetupStep { Name, Options, Players, Seating, Objectives }

    private SetupStep current = SetupStep.Name;

    private static readonly (SetupStep Step, string Key)[] Steps =
    {
        (SetupStep.Name, "setup.step.name"),
        (SetupStep.Options, "setup.step.options"),
        (SetupStep.Players, "setup.step.players"),
        (SetupStep.Seating, "setup.step.seating"),
        (SetupStep.Objectives, "setup.step.objectives"),
    };

    private Task SetName(ChangeEventArgs e)
        => Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(
            e.Value?.ToString(), null, null, null, null, null, null, null)));

    // Base is always in (the server ORs it back in anyway) — these three are the choices.
    private Task ToggleExpansion(Expansion x)
    {
        var now = Store.Session!.ActiveExpansions;
        var next = now.HasFlag(x) ? now & ~x : now | x;
        return Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(
            null, null, next | Expansion.Base, null, null, null, null, null)));
    }

    private string? TakenBy(string hex, Guid exceptId)
        => Store.Session!.Players.FirstOrDefault(p => p.Id != exceptId && string.Equals(p.ColorHex, hex, StringComparison.OrdinalIgnoreCase))?.Name;

    // Faction ids already chosen by OTHER players — removed from this player's faction picker.
    private IReadOnlySet<string> TakenFactions(Guid exceptId)
        => Store.Session!.Players
            .Where(p => p.Id != exceptId && !string.IsNullOrEmpty(p.FactionId))
            .Select(p => p.FactionId!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

    private Task SetTurnTimer(ChangeEventArgs e)
    {
        var seconds = int.TryParse(e.Value?.ToString(), out var s) ? s : 0;
        return Store.Mutate(Store.Api.UpdateSessionAsync(
            Sid, new UpdateSessionRequest(null, null, null, null, null, null, null, null, null, seconds)));
    }

    private Task SetCardsPerPlayer(ChangeEventArgs e)
    {
        var count = int.TryParse(e.Value?.ToString(), out var c) ? c : 0;
        return Store.Mutate(Store.Api.UpdateSessionAsync(
            Sid, new UpdateSessionRequest(null, null, null, null, null, null, null, null, null, null, count)));
    }

    private Task SetRedTapeVariant(ChangeEventArgs e)
    {
        var v = int.TryParse(e.Value?.ToString(), out var n) && Enum.IsDefined(typeof(RedTapeVariant), n)
            ? (RedTapeVariant)n : RedTapeVariant.None;
        return Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(
            null, null, null, null, null, null, null, null, null, null, RedTapeVariant: v)));
    }

    private Task SetRedTapeCard(ChangeEventArgs e)
    {
        var n = int.TryParse(e.Value?.ToString(), out var c) ? c : GameRules.RedTapeDiplomacyCard;
        return Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(
            null, null, null, null, null, null, null, null, null, null, RedTapeCardNumber: n)));
    }

    private Task SetPromptTech(ChangeEventArgs e)
        => Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(
            null, null, null, null, null, null, null, null, null, null, PromptTechOnAction: e.Value as bool? ?? false)));

    private Task SetName(Guid id, ChangeEventArgs e)
        => Store.Mutate(Store.Api.UpdatePlayerAsync(Sid, id, new UpdatePlayerRequest(e.Value?.ToString(), null, null, null, null, null)));
    private Task SetFactionId(Guid id, string factionId)
        => Store.Mutate(Store.Api.UpdatePlayerAsync(Sid, id, new UpdatePlayerRequest(null, factionId, null, null, null, null)));
    private Task SetColor(Guid id, string hex)
        => Store.Mutate(Store.Api.UpdatePlayerAsync(Sid, id, new UpdatePlayerRequest(null, null, hex, null, null, null)));
    private Task SetReady(Guid id, bool ready)
        => Store.Mutate(Store.Api.UpdatePlayerAsync(Sid, id, new UpdatePlayerRequest(null, null, null, null, ready, null)));
    private Task SetSpeaker(Guid id)
        => Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(null, null, null, null, null, null, null, id)));

    // Swap seat order with the neighbour in the given direction (host only).
    private async Task MoveSeat(int index, int dir)
    {
        var ordered = Store.Session!.Players.OrderBy(p => p.SeatOrder).ToList();
        var j = index + dir;
        if (j < 0 || j >= ordered.Count) return;
        var a = ordered[index];
        var b = ordered[j];
        await Store.Api.UpdatePlayerAsync(Sid, a.Id, new UpdatePlayerRequest(null, null, null, null, null, b.SeatOrder));
        await Store.Api.UpdatePlayerAsync(Sid, b.Id, new UpdatePlayerRequest(null, null, null, null, null, a.SeatOrder));
        await Store.RefreshAsync();
    }

    private async Task Remove(Guid id)
    {
        await Store.Api.RemovePlayerAsync(Sid, id);
        await Store.RefreshAsync();
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        await Store.AddLocalPlayerAsync(newName.Trim());
        newName = "";
    }
}
