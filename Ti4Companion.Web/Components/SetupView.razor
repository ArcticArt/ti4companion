        => Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(null, null, null, null, null, null, null, id)));

    // Swap seat order with the neighbour in the given direction (host only).
    private async Task MoveSeat(int index, int dir)
    {
        var ordered = Store.Session!.Players.OrderBy(p => p.SeatOrder).ToList();
        var j = index + dir;
        if (j < 0 || j >= ordered.Count) return;
        var a = ordered[index];
        var b = ordered[j];
        await Store.Api.UpdatePlayerAsync(Sid, a.Id, new UpdatePlayerRequest(null, null, null, null, null, b.SeatOrder));
        await Store.Api.UpdatePlayerAsync(Sid, b.Id, new UpdatePlayerRequest(null, null, null, null, null, a.SeatOrder));
        await Store.RefreshAsync();
    }

    private async Task Remove(Guid id)
    {
        await Store.Api.RemovePlayerAsync(Sid, id);
        await Store.RefreshAsync();
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        await Store.AddLocalPlayerAsync(newName.Trim());
        newName = "";
    }
