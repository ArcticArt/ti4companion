@* A technology rendered as a card. Unit-upgrade techs delegate to the shared UnitCardView (unit
   silhouette by type, ★ ability keywords, stat boxes at the bottom). Other techs keep the printed
   layout: faction marker top-left (circular), prerequisites bottom-left, the tech-point colour symbol
   bottom-right. Clickable to add. *@

@if (Tech.Color == TechColor.Unit)
{
    <UnitCardView Vm="BuildUnitVm()" Compact="Compact" OnClick="OnClick" />
}
else
{
    <div class="techcard @(Compact ? "compact" : "") @(OnClick.HasDelegate ? "clickable" : "")" style="--tc:@ColorHex(Tech.Color)" @onclick="HandleClick">
        @if (Tech.FactionId is not null)
        {
            var f = Store.Faction(Tech.FactionId);
            <span class="tc-fac" title="@FactionName(f)">
                @if (f is { IconPath: { } ip } && !string.IsNullOrEmpty(ip)) { <img src="@ip" alt="" /> }
                else { <span class="tc-facfb">★</span> }
            </span>
        }

        <div class="tc-pre">
            @foreach (var ch in Tech.Prerequisites) { <TechIcon Letter="ch" Size="@(Compact ? 14 : 18)" /> }
        </div>

        <div class="tc-body">
            <div class="tc-name">@Loc.Pick(Tech.Name, Tech.NameDe)</div>
            @if (!Compact)
            {
                <div class="tc-desc">@Loc.Pick(Tech.Text, Tech.TextDe)</div>
            }
        </div>

        <div class="tc-point"><TechIcon Color="Tech.Color" Size="@(Compact ? 24 : 36)" /></div>
    </div>
}

@code {
    [Parameter, EditorRequired] public TechnologyDto Tech { get; set; } = default!;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Inject] private Loc Loc { get; set; } = default!;
    [Inject] private SessionStore Store { get; set; } = default!;

    private Task HandleClick() => OnClick.HasDelegate ? OnClick.InvokeAsync() : Task.CompletedTask;

    private string FactionName(FactionDto? f) => f is null ? Loc["tech.faction"] : Loc.Pick(f.Name, f.NameDe);

    private UnitCardVM BuildUnitVm()
    {
        var (stats, abilities, desc) = UnitText.ParseTechText(Loc.Pick(Tech.Text, Tech.TextDe), Tech.UnitType, StatLabel);
        return new UnitCardVM(
            Loc.Pick(Tech.Name, Tech.NameDe),
            ColorHex(Tech.Color),
            Tech.UnitType,
            Tech.FactionId,
            Tech.Prerequisites,
            string.IsNullOrWhiteSpace(desc) ? null : desc,
            abilities,
            stats);
    }

    private string StatLabel(string key) => key.ToLowerInvariant() switch
    {
        "cost" => Loc["unit.cost"],
        "combat" => Loc["unit.combat"],
        "move" => Loc["unit.move"],
        "capacity" => Loc["unit.capacity"],
        _ => key,
    };

    private static string ColorHex(TechColor c) => c switch
    {
        TechColor.Biotic => "#4caf50",
        TechColor.Propulsion => "#4a78d6",
        TechColor.Cybernetic => "#e0c341",
        TechColor.Warfare => "#d6534a",
        _ => "#9aa7c0",
    };
}
