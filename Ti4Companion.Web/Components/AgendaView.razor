@inherits Ti4ComponentBase

@{
    var s = Store.Session!;
    var current = Store.Agenda(s.CurrentAgendaId);
    var kind = current is null ? ElectType.ForAgainst : AgendaDisplay.ElectKind(current);
    var host = Store.IsHost;
    var stage = Store.CurrentAgendaStage;
    var hidden = s.AgendaVotesHidden;
    var voting = stage is AgendaStage.VotingOpen or AgendaStage.VotingHidden;
    // The host may only reveal a face-down vote once every player's vote is locked (so nobody peeks early).
    var allLocked = s.Players.Count > 0 && s.Players.All(p => s.AgendaVotes.Any(v => v.PlayerId == p.Id && v.Locked));
    // For the host, exactly one row is "open" for entry at a time (their own by default; switched via "Vote").
    var effOpenFor = host && openFor == Guid.Empty ? (Store.MyPlayerId ?? Guid.Empty) : openFor;

    // ±1/5/10 weight stepper for the local vote draft (dVotes).
    RenderFragment draftStepper =
        @<span class="row-wrap vote-step" style="gap:.15rem;align-items:center;">
            <button class="btn btn-sm" disabled="@(dVotes == 0)" @onclick="() => dVotes = Math.Max(0, dVotes - 10)">−10</button>
            <button class="btn btn-sm" disabled="@(dVotes == 0)" @onclick="() => dVotes = Math.Max(0, dVotes - 5)">−5</button>
            <button class="btn btn-sm" disabled="@(dVotes == 0)" @onclick="() => dVotes = Math.Max(0, dVotes - 1)">−1</button>
            <span class="vote-step-n">@dVotes</span>
            <button class="btn btn-sm" @onclick="() => dVotes += 1">+1</button>
            <button class="btn btn-sm" @onclick="() => dVotes += 5">+5</button>
            <button class="btn btn-sm" @onclick="() => dVotes += 10">+10</button>
            <span class="faint">@Loc["agenda.votes"]</span>
        </span>;
}

<div class="panel">
    <h3 style="margin:0 0 .5rem;">@Loc["agenda.title"]</h3>

    @* ===== Influence entry (before the vote starts) ===== *@
    @if (!voting)
    {
        <div class="agenda-influence">
            <div class="row-wrap" style="justify-content:space-between;align-items:baseline;gap:.5rem;">
                <strong>@Loc["agenda.influence"]</strong>
                <span class="faint" style="font-size:.75rem;">@Loc["agenda.influenceHint"]</span>
            </div>
            @foreach (var p in Store.AgendaOrder())
            {
                var mineRow = p.Id == Store.MyPlayerId;
                var canEdit = host || mineRow;     // privacy: a non-host only sees/edits their own influence
                var isSpeaker = s.SpeakerPlayerId == p.Id;
                <div class="player-card inf-row" style="--player-color:@p.ColorHex;">
                    <FactionBadge Faction="Store.Faction(p.FactionId)" Size="1.6" Ring="@p.ColorHex" />
                    <strong class="inf-name">@p.Name @if (isSpeaker) { <SpeakerIcon SizeCss="1.2em" /> }</strong>
                    @if (canEdit)
                    {
                        <span class="row-wrap vote-step inf-step" style="gap:.15rem;align-items:center;">
                            <button class="btn btn-sm" disabled="@(p.Influence == 0)" @onclick="() => SetInfluence(p.Id, p.Influence - 5)">−5</button>
                            <button class="btn btn-sm" disabled="@(p.Influence == 0)" @onclick="() => SetInfluence(p.Id, p.Influence - 1)">−1</button>
                            <span class="vote-step-n">@p.Influence</span>
                            <button class="btn btn-sm" @onclick="() => SetInfluence(p.Id, p.Influence + 1)">+1</button>
                            <button class="btn btn-sm" @onclick="() => SetInfluence(p.Id, p.Influence + 5)">+5</button>
                        </span>
                    }
                    else
                    {
                        <span class="faint">···</span>
                    }
                </div>
            }
        </div>
    }

    @* ===== Agenda selection / card ===== *@
    @if (current is null)
    {
        @if (host)
        {
            <p class="faint" style="margin:.6rem 0 .3rem;">@Loc["agenda.pick"]</p>
            <input type="text" @bind="search" @bind:event="oninput" placeholder="@SearchPlaceholder" />
            <div class="grid" style="gap:.3rem;margin-top:.6rem;max-height:48vh;overflow:auto;">
                @foreach (var a in Matches())
                {
                    <button class="btn btn-ghost agenda-pick" @onclick="() => Reveal(a.Id)">
                        <span class="chip @(a.Type == AgendaType.Law ? "chip-active" : "")">@Loc[a.Type == AgendaType.Law ? "agenda.law" : "agenda.directive"]</span>
                        <strong>@Loc.Pick(a.Name, a.NameDe)</strong>
                        @if (!string.IsNullOrEmpty(a.Elect)) { <span class="faint">· @a.Elect</span> }
                    </button>
                }
            </div>
            @if (Matches().Count == 0) { <p class="faint">@Loc["agenda.none"]</p> }
        }
        else
        {
            <p class="faint" style="margin-top:.6rem;">@Loc["agenda.waitingForHost"]</p>
        }
    }
    else
    {
        <div class="agenda-card">
            <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;">
                <span class="chip @(current.Type == AgendaType.Law ? "chip-active" : "")">@Loc[current.Type == AgendaType.Law ? "agenda.law" : "agenda.directive"]</span>
                <h3 style="margin:0;color:var(--gold);">@Loc.Pick(current.Name, current.NameDe)</h3>
            </div>
            @if (!string.IsNullOrEmpty(current.Elect)) { <div class="faint" style="margin:.2rem 0;">@Loc["agenda.elect"]: @current.Elect</div> }
            <p style="margin:.4rem 0;">@Loc.Pick(current.Text, current.TextDe)</p>

            @if (host)
            {
                <div class="row-wrap" style="gap:.4rem;align-items:center;margin-top:.3rem;">
                    @if (stage == AgendaStage.AgendaRevealed)
                    {
                        <button class="btn btn-sm btn-gold" @onclick="() => StartVote(false)">@Loc["agenda.startVote"]</button>
                        <button class="btn btn-sm" @onclick="() => StartVote(true)">@Loc["agenda.startVoteHidden"]</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-danger" @onclick="CancelVote">@Loc["agenda.cancelVote"]</button>
                        @if (hidden)
                        {
                            <button class="btn btn-sm btn-gold" disabled="@(!allLocked)" @onclick="RevealVotes">@Loc["agenda.reveal"]</button>
                            @if (!allLocked) { <span class="faint">@Loc["agenda.lockAllFirst"]</span> }
                        }
                    }
                    <button class="btn btn-sm" @onclick="() => Reveal(null)">↻ @Loc["agenda.revealNew"]</button>
                </div>
                @if (hidden && voting) { <p class="faint" style="font-size:.78rem;margin:.4rem 0 0;">@Loc["agenda.hostHint"]</p> }
            }
        </div>

        @* ===== Voting ===== *@
        @if (voting)
        {
            <div style="margin-top:.8rem;">
                @if (hidden)
                {
                    <p class="faint" style="margin:.2rem 0 .5rem;">@Loc["agenda.hidden"]</p>
                }
                else if (kind == ElectType.ForAgainst)
                {
                    var forVotes = s.AgendaVotes.Where(v => v.Locked && v.Outcome == VoteOutcome.For).Sum(v => v.Votes);
                    var againstVotes = s.AgendaVotes.Where(v => v.Locked && v.Outcome == VoteOutcome.Against).Sum(v => v.Votes);
                    <div class="row-wrap" style="gap:1rem;margin-bottom:.5rem;">
                        <span class="chip chip-done">@Loc["agenda.for"]: @forVotes</span>
                        <span class="chip chip-passed">@Loc["agenda.against"]: @againstVotes</span>
                    </div>
                }
                else
                {
                    var tally = Tally();
                    var lead = tally.Count == 0 ? 0 : tally[0].Votes;
                    <div class="row-wrap" style="gap:.5rem;margin-bottom:.5rem;">
                        @if (tally.Count == 0) { <span class="faint">@Loc["agenda.noVotes"]</span> }
                        @foreach (var t in tally)
                        {
                            <span class="chip @(t.Votes == lead ? "chip-active" : "")">
                                @AgendaDisplay.ChoiceLabel(Store, Loc, current, t.Choice): @t.Votes
                                @if (t.Votes == lead) { <text> · @Loc["agenda.leading"]</text> }
                            </span>
                        }
                    </div>
                }

                @foreach (var p in Store.AgendaOrder())
                {
                    var vote = s.AgendaVotes.FirstOrDefault(v => v.PlayerId == p.Id);
                    var locked = vote?.Locked == true;
                    var mineRow = p.Id == Store.MyPlayerId;
                    var isSpeaker = s.SpeakerPlayerId == p.Id;
                    var cands = AgendaDisplay.Candidates(Store, Loc, current);
                    var open = !locked && (host ? effOpenFor == p.Id : mineRow);
                    <div class="player-card @(isSpeaker ? "speaker-row" : "")" style="--player-color:@p.ColorHex;gap:.5rem;flex-wrap:wrap;">
                        <FactionBadge Faction="Store.Faction(p.FactionId)" Size="1.8" Ring="@p.ColorHex" />
                        <strong style="flex:1 1 120px;">@p.Name @if (isSpeaker) { <SpeakerIcon SizeCss="1.3em" /> }</strong>

                        @if (open)
                        {
                            @* Draft held locally; nothing is sent until "Lock". *@
                            @if (kind == ElectType.ForAgainst)
                            {
                                <div class="row-wrap" style="gap:.25rem;">
                                    <button class="btn btn-sm @(dOutcome == VoteOutcome.For ? "btn-gold" : "")" @onclick="() => SetDraft(VoteOutcome.For)">@Loc["agenda.for"]</button>
                                    <button class="btn btn-sm @(dOutcome == VoteOutcome.Against ? "btn-danger" : "")" @onclick="() => SetDraft(VoteOutcome.Against)">@Loc["agenda.against"]</button>
                                    <button class="btn btn-sm @(dOutcome == VoteOutcome.Abstain ? "btn-gold" : "")" @onclick="() => SetDraft(VoteOutcome.Abstain)">@Loc["agenda.abstain"]</button>
                                </div>
                            }
                            else
                            {
                                <div class="row-wrap" style="gap:.25rem;align-items:center;flex:1 1 240px;">
                                    @if (cands.Count > 0)
                                    {
                                        <select value="@dChoice" @onchange="e => SetDraftChoice(e.Value?.ToString())" style="flex:1;min-width:0;">
                                            <option value="">@Loc["agenda.choose"]</option>
                                            @foreach (var c in cands) { <option value="@c.Key" selected="@(c.Key == dChoice)">@c.Label</option> }
                                        </select>
                                    }
                                    @if (AgendaDisplay.AllowsFreeText(kind))
                                    {
                                        <input type="text" value="@(cands.Any(c => c.Key == dChoice) ? "" : dChoice)" placeholder="@Loc["agenda.freeText"]" @onchange="e => SetDraftChoice(e.Value?.ToString())" style="flex:1;min-width:0;" />
                                    }
                                    <button class="btn btn-sm @(dOutcome == VoteOutcome.Abstain ? "btn-gold" : "")" @onclick="() => SetDraft(VoteOutcome.Abstain)">@Loc["agenda.abstain"]</button>
                                </div>
                            }
                            @if (dOutcome != VoteOutcome.Abstain) { @draftStepper }
                            <button class="btn btn-sm btn-gold" @onclick="() => Commit(p.Id)">@Loc["agenda.lock"]</button>
                        }
                        else if (locked && !hidden)
                        {
                            @* Open vote, already locked → show the result to everyone. *@
                            @if (vote!.Outcome == VoteOutcome.Abstain) { <span class="faint">@Loc["agenda.abstain"]</span> }
                            else
                            {
                                <span>@(kind == ElectType.ForAgainst ? Loc[vote.Outcome == VoteOutcome.For ? "agenda.for" : "agenda.against"] : AgendaDisplay.ChoiceLabel(Store, Loc, current, vote.Choice))</span>
                                <span class="chip">@vote.Votes @Loc["agenda.votes"]</span>
                            }
                        }
                        else
                        {
                            @* Not open here → status only (face-down keeps the value secret until reveal). *@
                            <span class="chip @(locked ? "chip-done" : "")">@(locked ? Loc["agenda.locked"] : Loc["agenda.waiting"])</span>
                            @if (host && !locked && effOpenFor != p.Id) { <button class="btn btn-sm" @onclick="() => OpenFor(p.Id)">@Loc["agenda.castFor"]</button> }
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private Guid Sid => Store.Session!.Id;
    private string search = "";
    private Guid openFor = Guid.Empty; // host: which player's vote is currently open for entry (defaults to self)
    private string SearchPlaceholder => Loc["agenda.search"];

    private List<AgendaDto> Matches()
    {
        var q = search?.Trim() ?? "";
        return Store.ActiveAgendas()
            .Where(a => q.Length == 0 || Loc.Pick(a.Name, a.NameDe).Contains(q, StringComparison.OrdinalIgnoreCase))
            .OrderBy(a => Loc.Pick(a.Name, a.NameDe))
            .Take(40).ToList();
    }

    private List<(string Choice, int Votes)> Tally()
        => Store.Session!.AgendaVotes
            .Where(v => v.Locked && !string.IsNullOrEmpty(v.Choice) && v.Votes > 0)
            .GroupBy(v => v.Choice!)
            .Select(g => (Choice: g.Key, Votes: g.Sum(v => v.Votes)))
            .OrderByDescending(t => t.Votes)
            .ToList();

    private Task Reveal(string? agendaId) { openFor = Guid.Empty; ResetDraft(); return Store.Mutate(Store.Api.SetAgendaAsync(Sid, agendaId)); }
    private Task SetInfluence(Guid playerId, int value) => Store.Mutate(Store.Api.SetInfluenceAsync(Sid, playerId, Math.Max(0, value)));
    private async Task StartVote(bool hidden) { openFor = Guid.Empty; ResetDraft(); await Store.Mutate(Store.Api.StartVotingAsync(Sid, hidden)); }
    private async Task CancelVote() { openFor = Guid.Empty; ResetDraft(); await Store.Mutate(Store.Api.CancelVotingAsync(Sid)); }
    private Task RevealVotes() => Store.Mutate(Store.Api.RevealVotesAsync(Sid));

    // ---- Vote draft, committed only on lock ----
    private VoteOutcome dOutcome = VoteOutcome.Abstain;
    private int dVotes;
    private string? dChoice;

    private void ResetDraft() { dOutcome = VoteOutcome.Abstain; dVotes = 0; dChoice = null; }

    private void SetDraft(VoteOutcome o)
    {
        dOutcome = o;
        if (o == VoteOutcome.Abstain) { dVotes = 0; dChoice = null; }
        else if (dVotes < 1) dVotes = 1;
    }

    private void SetDraftChoice(string? c)
    {
        if (string.IsNullOrWhiteSpace(c)) { dChoice = null; dOutcome = VoteOutcome.Abstain; dVotes = 0; }
        else { dChoice = c.Trim(); dOutcome = VoteOutcome.For; if (dVotes < 1) dVotes = 1; }
    }

    private void OpenFor(Guid playerId) { openFor = playerId; ResetDraft(); }

    private async Task Commit(Guid playerId)
    {
        await Store.Mutate(Store.Api.LockVoteAsync(Sid, playerId, dOutcome, dVotes, dChoice));
        openFor = Guid.Empty;
        ResetDraft();
    }
}
