@inherits Ti4ComponentBase

@* Host-only match statistics + log overlay (opened from the app bar). Statistics are computed
   client-side from the structured match log (see MatchStats).

   With `EndGame` set it is the end-of-match dialog: same content, plus the three ways out at the bottom.
   Centred with the page blurred behind, like every other dialog. *@
<div class="modal-backdrop centered blurred" @onclick="Close">
    <div class="modal stats-modal" @onclick:stopPropagation="true">
        <div class="modal-head">
            <h3 style="margin:0;color:var(--gold);">@Loc["stats.title"]</h3>
            <div class="spacer" style="flex:1"></div>
            <button class="btn btn-sm btn-ghost" @onclick="Load" title='@Loc["stats.refresh"]'>↻</button>
            <button class="btn btn-sm btn-ghost" @onclick="Close" title='@Loc["common.close"]'>✕</button>
        </div>

        <div class="tabs" style="margin:.4rem 0 .6rem;">
            <div class="tab @(tab == 0 ? "active" : "")" @onclick="() => tab = 0">@Loc["stats.tabStats"]</div>
            <div class="tab @(tab == 1 ? "active" : "")" @onclick="() => tab = 1">@Loc["stats.tabLog"]</div>
        </div>

        <div class="modal-body">
            @if (loading)
            {
                <p class="faint">@Loc["common.loading"]</p>
            }
            else if (tab == 0)
            {
                @if (stats.StartedUtc is null)
                {
                    <p class="faint">@Loc["stats.notStarted"]</p>
                }
                else
                {
                    <div class="stat-block">
                        <div class="stat-big"><span class="stat-label">@Loc["stats.match"]</span><span class="stat-val">@MatchStats.Format(stats.Match ?? TimeSpan.Zero)</span></div>
                    </div>

                    <div class="stat-block">
                        <h4>@Loc["stats.perRound"]</h4>
                        @foreach (var r in stats.Rounds)
                        {
                            <div class="stat-row"><span>@Loc["stats.round"] @r.Round</span><span class="stat-val">@MatchStats.Format(r.Duration)</span></div>
                        }
                    </div>

                    <div class="stat-block">
                        <h4>@Loc["stats.perPhase"]</h4>
                        @foreach (var ph in PhaseOrder.Where(p => stats.PhaseTotals.ContainsKey(p)))
                        {
                            <div class="stat-row"><span>@Loc[$"phase.{ph}"]</span><span class="stat-val">@MatchStats.Format(stats.PhaseTotals[ph])</span></div>
                        }
                    </div>

                    <div class="stat-block">
                        <h4>@Loc["stats.perPlayer"]</h4>
                        @foreach (var p in Store.Session!.Players.OrderByDescending(p => PlayerTime(p.Id)))
                        {
                            <div class="stat-row" style="--player-color:@p.ColorHex">
                                <span class="stat-player"><FactionBadge Faction="Store.Faction(p.FactionId)" Size="1.4" Ring="@p.ColorHex" /> @p.Name</span>
                                <span class="stat-val">@MatchStats.Format(PlayerTime(p.Id))</span>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                @if (log.Count == 0)
                {
                    <p class="faint">@Loc["stats.empty"]</p>
                }
                else
                {
                    <div class="log-list">
                        @foreach (var e in log.Where(e => !HideInLog(e.Kind)).OrderByDescending(l => l.TimestampUtc))
                        {
                            <div class="log-row">
                                <span class="log-time">@e.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                                <span class="log-actor">@Actor(e.ActorPlayerId)</span>
                                <span class="log-desc">@LogLine(e)</span>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* End of the match: keep playing, start over with the same table, or leave. Both of the latter
           ARCHIVE first — the summary is written, then the match itself is gone. *@
        @if (EndGame)
        {
            <div class="endgame-actions">
                <button class="btn btn-gold btn-lg" @onclick="Close">@Loc["endgame.continue"]</button>
                <button class="btn btn-lg" disabled="@busy" @onclick="() => Archive(true)">@Loc["endgame.backToSetup"]</button>
                <button class="btn btn-danger btn-lg" disabled="@busy" @onclick="() => Archive(false)">@Loc["endgame.exit"]</button>
            </div>
            <p class="faint endgame-note">@Loc["endgame.note"]</p>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Show the three end-of-match actions (opened from the app bar's "End game").</summary>
    [Parameter] public bool EndGame { get; set; }

    /// <summary>Raised after the match was archived, with <c>true</c> when the session was deleted — the shell
    /// navigates away in that case.</summary>
    [Parameter] public EventCallback<bool> OnArchived { get; set; }

    private bool busy;

    private async Task Archive(bool reset)
    {
        if (busy || Store.Session is null) return;
        busy = true;
        await Store.Api.ArchiveSessionAsync(Store.Session.Id, reset);
        await OnArchived.InvokeAsync(!reset);
    }

    private int tab;
    private bool loading = true;
    private IReadOnlyList<SessionLogEntryDto> log = Array.Empty<SessionLogEntryDto>();
    private MatchStats stats = new();

    private static readonly GamePhase[] PhaseOrder =
        { GamePhase.Strategy, GamePhase.Action, GamePhase.Status, GamePhase.Agenda };

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true;
        StateHasChanged();
        var code = Store.Session?.JoinCode;
        log = code is null ? Array.Empty<SessionLogEntryDto>() : await Store.Api.GetLogAsync(code);
        stats = MatchStats.Compute(log, DateTimeOffset.UtcNow);
        loading = false;
        StateHasChanged();
    }

    private TimeSpan PlayerTime(Guid id) => stats.PerPlayer.TryGetValue(id, out var t) ? t : TimeSpan.Zero;

    private Task Close() => OnClose.InvokeAsync();

    // ---- Log line formatting (localized; ids resolved against the content bundle) ----
    private string Actor(Guid? id) => Store.PlayerById(id)?.Name ?? Loc["log.system"];
    private string Target(Guid? id) => Store.PlayerById(id)?.Name ?? "—";

    private string CardName(string? d)
    {
        if (int.TryParse(d, out var n) && Store.Card(n) is { } c) return Loc.Pick(c.Name, c.NameDe);
        return d ?? "";
    }
    private string ObjName(string? d) => string.IsNullOrEmpty(d) ? "" : (Store.Objective(d) is { } o ? Loc.Pick(o.Name, o.NameDe) : d);
    private string AgendaName(string? d) => string.IsNullOrEmpty(d) ? "" : (Store.Agenda(d) is { } a ? Loc.Pick(a.Name, a.NameDe) : d);
    private string TechName(string? d) => string.IsNullOrEmpty(d) ? "" : (Store.Tech(d) is { } t ? Loc.Pick(t.Name, t.NameDe) : d);

    private string LogLine(SessionLogEntryDto e) => e.Kind switch
    {
        SessionLogKind.PlayerJoin => e.Detail == "host"
            ? string.Format(Loc["log.host"], Actor(e.ActorPlayerId))
            : string.Format(Loc["log.join"], Target(e.TargetPlayerId)),
        SessionLogKind.PhaseChange => string.Format(Loc["log.phaseChange"], Loc[$"phase.{e.Phase}"]),
        SessionLogKind.RoundChange => string.Format(Loc["log.roundChange"], e.Round),
        SessionLogKind.TurnChange => string.Format(Loc["log.turnChange"], Target(e.TargetPlayerId)),
        SessionLogKind.SpeakerSet => string.Format(Loc["log.speakerSet"], Target(e.TargetPlayerId)),
        SessionLogKind.StrategyPick => string.Format(Loc["log.strategyPick"], Target(e.TargetPlayerId), CardName(e.Detail)),
        SessionLogKind.StrategyReturn => string.Format(Loc["log.strategyReturn"], Target(e.TargetPlayerId), CardName(e.Detail)),
        SessionLogKind.StrategyAction => string.Format(Loc["log.strategyAction"], Target(e.TargetPlayerId), CardName(e.Detail)),
        SessionLogKind.Pass => string.Format(Loc["log.pass"], Target(e.TargetPlayerId)),
        SessionLogKind.ObjectiveReveal => string.Format(Loc["log.objectiveReveal"], ObjName(e.Detail)),
        SessionLogKind.ObjectiveScore => string.Format(Loc["log.objectiveScore"], Target(e.TargetPlayerId), ObjName(e.Detail)),
        SessionLogKind.TechAdd => string.Format(Loc["log.techAdd"], Target(e.TargetPlayerId), TechName(e.Detail)),
        SessionLogKind.TechRemove => string.Format(Loc["log.techRemove"], Target(e.TargetPlayerId), TechName(e.Detail)),
        SessionLogKind.AgendaReveal => string.IsNullOrEmpty(e.Detail) ? Loc["log.agendaNew"] : string.Format(Loc["log.agendaReveal"], AgendaName(e.Detail)),
        SessionLogKind.AgendaStartVote => e.Detail == "hidden" ? Loc["log.agendaStartHidden"] : Loc["log.agendaStart"],
        SessionLogKind.AgendaCancel => Loc["log.agendaCancel"],
        SessionLogKind.AgendaReveal2 => Loc["log.agendaReveal2"],
        SessionLogKind.VoteLock => string.Format(Loc["log.voteLock"], Target(e.TargetPlayerId)),
        SessionLogKind.InfluenceSet => string.Format(Loc["log.influenceSet"], Target(e.TargetPlayerId), e.Detail),
        SessionLogKind.AgendaResult => AgendaResultLine(e.Detail),
        SessionLogKind.GamePaused => Loc["log.gamePaused"],
        SessionLogKind.GameResumed => Loc["log.gameResumed"],
        // The app pulled a tape or purged an objective on its own — the two entries that say what it did.
        SessionLogKind.CombatStart => string.Format(Loc["log.combatStart"], Target(e.ActorPlayerId), Target(e.TargetPlayerId)),
        SessionLogKind.CombatEnd => Loc["log.combatEnd"],
        SessionLogKind.RedTapeRandom => string.Format(Loc["log.redTapeRandom"], ObjName(e.Detail)),
        SessionLogKind.RedTapePurge => string.Format(Loc["log.redTapePurge"], ObjName(e.Detail)),
        // A device took a seat over — the host's included, which is why it is worth a line.
        SessionLogKind.SeatClaim => string.Format(Loc["log.seatClaim"], Target(e.TargetPlayerId)),
        _ => Loc["log.generic"],
    };

    // Agenda-phase noise we no longer surface in the log (only reveal + the summarised result remain).
    private static bool HideInLog(SessionLogKind k) => k is SessionLogKind.AgendaStartVote
        or SessionLogKind.AgendaCancel or SessionLogKind.AgendaReveal2 or SessionLogKind.AgendaRevealTotals
        or SessionLogKind.VoteLock or SessionLogKind.InfluenceSet;

    // Render the packed agenda result ("agendaId|for|against|topChoiceKey|topVotes|runnerUpVotes").
    private string AgendaResultLine(string? detail)
    {
        if (string.IsNullOrEmpty(detail)) return Loc["log.agendaResult"];
        var parts = detail.Split('|');
        var agenda = Store.Agenda(parts.ElementAtOrDefault(0));
        var name = agenda is null ? (parts.ElementAtOrDefault(0) ?? "") : Loc.Pick(agenda.Name, agenda.NameDe);
        var elect = agenda is null ? ElectType.ForAgainst : AgendaDisplay.ElectKind(agenda);
        if (elect == ElectType.ForAgainst)
        {
            int.TryParse(parts.ElementAtOrDefault(1), out var f);
            int.TryParse(parts.ElementAtOrDefault(2), out var a);
            var res = f > a ? Loc["agenda.passed"] : a > f ? Loc["agenda.rejected"] : Loc["agenda.speakerDecides"];
            return $"{name}: {Loc["agenda.for"]} {f} · {Loc["agenda.against"]} {a} — {res}";
        }
        int.TryParse(parts.ElementAtOrDefault(4), out var topV);
        int.TryParse(parts.ElementAtOrDefault(5), out var secV);
        if (topV == 0) return $"{name}: {Loc["agenda.noVotes"]}";
        if (topV == secV) return $"{name}: {Loc["agenda.speakerDecides"]}";
        return $"{name}: {Loc["agenda.elected"]} {AgendaDisplay.ChoiceLabel(Store, Loc, elect, parts.ElementAtOrDefault(3))} ({topV})";
    }
}
