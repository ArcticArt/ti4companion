@* In-game color swatches (plastics / command-sheet colors). Colors already taken by others are dimmed. *@

<div class="swatches">
    @foreach (var c in Ti4Colors.All)
    {
        var taken = TakenBy(c.Hex);
        var mine = string.Equals(Current, c.Hex, StringComparison.OrdinalIgnoreCase);
        @* Hide colours taken by other players (your own stays; a freed colour reappears for everyone).
           Clicking your OWN colour deselects it (frees it) — so two players can swap even when all are taken. *@
        if (taken is not null && !mine) { continue; }
        <button class="swatch @(mine ? "sel" : "")" style="background:@c.Hex" title="@(mine ? DeselectTitle : SwatchTitle(c.Name, taken))"
                disabled="@Disabled" @onclick="() => Pick(mine, c.Hex)">
            @if (mine) { <MaterialIcon Name="check" /> }
        </button>
    }
</div>

@code {
    [Parameter] public string? Current { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> OnPick { get; set; }
    /// <summary>Optional: which player name currently holds each color, to hint at clashes.</summary>
    [Parameter] public Func<string, string?>? TakenByResolver { get; set; }
    [Inject] private Loc Loc { get; set; } = default!;

    private string DeselectTitle => Loc["setup.deselectColor"];
    // Clicking your own colour deselects it (empty = unchosen, frees it for swapping).
    private Task Pick(bool mine, string hex) => OnPick.InvokeAsync(mine ? "" : hex);
    private string? TakenBy(string hex) => TakenByResolver?.Invoke(hex);

    private static string SwatchTitle(string name, string? taken) => taken is null ? name : $"{name} ({taken})";
}
