@inherits Ti4ComponentBase

@*
    The status phase, walked through in three stages (GameSession.StatusStage):
      1. scoring   — each player in initiative order taps ONE objective card, like taking a strategy card
      2. reveal    — the next public objective goes on the table, shown large on the wall
      3. checklist — the remaining upkeep steps, also large on the wall

    Only the host moves between stages, and the target stage is absolute (see SetStatusStage) so a double
    tap can't skip one. Nothing is enforced: every stage can be left at any time, in either direction.
*@
@{
    var s = Store.Session!;
    var host = Store.IsHost;
    var stage = s.StatusStage;
    var ordered = s.Players.OrderBy(p => p.Initiative ?? int.MaxValue).ThenBy(p => p.SeatOrder).ToList();
    var scorerId = s.StatusScorerId;
    var scorer = ordered.FirstOrDefault(p => p.Id == scorerId);
    var mine = scorerId is not null && scorerId == Store.MyPlayerId;
    var allDone = scorerId is null;
}

@* Stage strip: where the table is, and the host's way forward/back. *@
<div class="panel status-stagebar">
    <div class="stage-strip">
        @foreach (var (st, key) in Stages)
        {
            <div class="stage-seg @(stage == st ? "on" : stage > st ? "done" : "")">@Loc[key]</div>
        }
    </div>
    @if (host)
    {
        <div class="stage-nav">
            @if (stage > StatusStage.Scoring)
            {
                <button class="btn btn-sm" @onclick="() => GoStage(stage - 1)"><MaterialIcon Name="chevron_left" /> @Loc["common.back"]</button>
            }
            @if (stage < StatusStage.Checklist)
            {
                <button class="btn btn-sm btn-gold" @onclick="() => GoStage(stage + 1)">@Loc["status.next"] <MaterialIcon Name="chevron_right" /></button>
            }
        </div>
    }
</div>

@switch (stage)
{
    case StatusStage.Scoring:
        @* Who is up, in initiative order. It used to be simultaneous, so nobody could tell who still
           owed a decision. A guide plus the matching server gate — the game itself is not enforced. *@
        <div class="panel" style="margin-top:.6rem;">
            <div class="scoring-head">
                <h3 style="margin:0;">@Loc["status.scoringOrder"]</h3>
                @if (allDone)
                {
                    <span class="chip chip-done">@Loc["status.allScored"]</span>
                }
                else if (scorer is not null)
                {
                    <span class="faint">@(mine ? Loc["status.yourTurn"] : string.Format(Loc["status.waitingFor"], scorer.Name))</span>
                }
            </div>

            <div class="scoring-order">
                @foreach (var p in ordered)
                {
                    var isCurrent = p.Id == scorerId;
                    <div class="so-row @(isCurrent ? "current" : "") @(p.StatusDone ? "done" : "")" style="--player-color:@p.ColorHex">
                        <span class="so-init">@(p.Initiative?.ToString() ?? "—")</span>
                        <FactionBadge Faction="Store.Faction(p.FactionId)" Size="1.8" Ring="@p.ColorHex" />
                        <span class="so-name">@p.Name</span>
                        @if (p.StatusDone)
                        {
                            <span class="chip chip-done"><MaterialIcon Name="check" /></span>
                            @if (host || p.Id == Store.MyPlayerId)
                            {
                                <button class="btn btn-sm btn-ghost" @onclick="() => SetDone(p.Id, false)" title='@Loc["status.undoDone"]'><MaterialIcon Name="undo" /></button>
                            }
                        }
                        else if (isCurrent && (host || p.Id == Store.MyPlayerId))
                        {
                            <button class="btn btn-sm btn-gold" @onclick="() => SetDone(p.Id, true)">@Loc["status.done"] <MaterialIcon Name="check" /></button>
                        }
                    </div>
                }
            </div>
        </div>

        @* Score by tapping the card itself (not via the little markers, as in the action phase). The list is
           what the player who is up can actually DO: a taped or purged objective is not scorable, so it is not
           here (the Objectives tab still shows the whole table, one tap away, tape and all). The ones they have
           already scored stay, marked, and tapping one takes it back — a mis-tap has to be undoable in the
           same place it happened, which is the reason the list is not simply filtered down to "not yet
           scored". *@
        <div class="panel" style="margin-top:.6rem;">
            @if (scorer is not null)
            {
                <h3 style="margin:0 0 .2rem;">@string.Format(Loc["status.scoreFor"], scorer.Name)</h3>
                <p class="faint" style="margin:0 0 .5rem;">@Loc["status.tapToScore"]</p>
            }
            else
            {
                <h3 style="margin:0 0 .5rem;">@Loc["obj.title"]</h3>
            }
            @{
                var scorable = Scorable(s, scorer);
            }
            @if (scorable.Count == 0)
            {
                <p class="faint" style="margin:0;">@Loc[s.Objectives.Count == 0 ? "obj.none" : "status.nothingScorable"]</p>
            }
            else
            {
                <div class="obj-tap-grid">
                    @foreach (var so in scorable)
                    {
                        var soId = so.Id;
                        var already = scorer is not null && so.ScoredByPlayerIds.Contains(scorer.Id);
                        <ObjectiveDisplayCard So="so"
                                              Clickable="scorer is not null && Store.CanScoreFor(scorer.Id)"
                                              Undo="already"
                                              OnClick="() => Toggle(soId, scorer!.Id, already)"
                                              TapeClickable="true"
                                              OnRemoveTape="() => RemoveTape(soId)"
                                              OnLockedTap="AskLocked" />
                    }
                </div>
            }
        </div>
        break;

    case StatusStage.RevealObjective:
        @* Bureaucracy replaces this step outright: everything is already face-up, so nothing is revealed and
           the step becomes a game-end check ("the game ends if there are no unrevealed public objectives at
           the start of this step" — rulebook insert). Red Tape Lite keeps revealing, so it keeps the box. *@
        var bureaucracy = s.RedTapeVariant == RedTapeVariant.Bureaucracy;
        <div class="panel" style="margin-top:.6rem;">
            <h3 style="margin:0 0 .2rem;">@Loc[bureaucracy ? "redtape.stepReplaced" : "status.stage.reveal"]</h3>
            <p class="faint" style="margin:0;">@Loc[bureaucracy ? "redtape.stepReplacedHint" : "status.revealHint"]</p>
        </div>
        <ObjectivesTab RevealOnTop="true" Scoreable="false" />
        break;

    case StatusStage.Checklist:
        @* Short wording here, the full rules text on the wall — the host needs a list, the table needs
           the explanation. *@
        <div class="panel" style="margin-top:.6rem;">
            <h3 style="margin:0 0 .4rem;">@Loc["status.checklist"]</h3>
            @* Ticking the steps is the host's job — everyone else reads along, so the list renders without
               a box for them. The checklist is shared state, and eight devices toggling one row is noise. *@
            <div class="status-steps">
                @foreach (var (step, key) in Steps)
                {
                    var done = s.StatusStepsDone.HasFlag(step);
                    @if (host)
                    {
                        <button class="step @(done ? "done" : "")" @onclick="() => ToggleStep(step, !done)">
                            <span class="step-box">@if (done) { <MaterialIcon Name="check" SizeCss="1em" /> }</span>
                            <span>@Loc[key]</span>
                        </button>
                    }
                    else
                    {
                        <div class="step readonly @(done ? "done" : "")">
                            <span class="step-mark">@if (done) { <MaterialIcon Name="check" SizeCss="1em" /> }</span>
                            <span>@Loc[key]</span>
                        </div>
                    }
                }
            </div>
        </div>
        break;
}

@* Same question as in the objectives tab: a tape a timing rule holds shut can be tapped, and overruled. *@
<RedTapeSealModal Mode="@sealMode" Locked="@lockedAsk" OnClose="CloseSeal" />

@code {
    private Guid Sid => Store.Session!.Id;

    private RedTapeSealModal.SealMode? sealMode;
    private SessionObjectiveDto? lockedAsk;

    private void AskLocked(SessionObjectiveDto so)
    {
        lockedAsk = so;
        sealMode = RedTapeSealModal.SealMode.Locked;
    }

    private void CloseSeal()
    {
        sealMode = null;
        lockedAsk = null;
    }

    private static readonly (StatusStage Stage, string Key)[] Stages =
    {
        (StatusStage.Scoring, "status.stage.scoring"),
        (StatusStage.RevealObjective, "status.stage.reveal"),
        (StatusStage.Checklist, "status.stage.checklist"),
    };

    // The order and wording the user's table uses (command tokens discarded/gained is one entry).
    // "Reveal objective" is NOT here anymore — it is its own stage. The last entry is not a rulebook step
    // but the thing that gets forgotten: abilities that fire during or at the end of the phase.
    private static readonly (StatusStep Step, string Key)[] Steps =
    {
        (StatusStep.DrawActionCards, "status.step.drawActionCards"),
        (StatusStep.CommandTokens, "status.step.commandTokens"),
        (StatusStep.ReadyCards, "status.step.readyCards"),
        (StatusStep.RepairUnits, "status.step.repairUnits"),
        (StatusStep.ReturnStrategyCards, "status.step.returnStrategyCards"),
        (StatusStep.EndOfStatusAbilities, "status.step.endAbilities"),
    };

    private Task GoStage(StatusStage stage) => Store.Mutate(Store.Api.SetStatusStageAsync(Sid, stage));

    private Task SetDone(Guid playerId, bool done)
        => Store.Mutate(Store.Api.SetStatusDoneAsync(Sid, playerId, done));

    private Task ToggleStep(StatusStep step, bool done)
        => Store.Mutate(Store.Api.SetStatusStepAsync(Sid, step, done));

    /// <summary>What the player who is up can act on: everything they may still score, plus what they have
    /// already scored this phase so a mis-tap can be taken back. A taped or purged objective can't be scored
    /// (the server refuses it too), so it would only be a card that does nothing when tapped.
    /// <para>With nobody up — everyone has said "done" — the same filter leaves the objectives that are
    /// simply on the table, which is what the heading then says.</para></summary>
    private List<SessionObjectiveDto> Scorable(SessionStateDto s, PlayerDto? scorer)
        => s.Objectives
            .Where(o => !o.Purged
                        && (!Store.RedTapeBlocks(o)
                            || (scorer is not null && o.ScoredByPlayerIds.Contains(scorer.Id))))
            // Still to score first, already scored after it: the top of the list is what there is to decide.
            .OrderBy(o => scorer is not null && o.ScoredByPlayerIds.Contains(scorer.Id) ? 1 : 0)
            .ToList();

    private Task Toggle(Guid sessionObjectiveId, Guid playerId, bool scored)
        => scored ? Unscore(sessionObjectiveId, playerId) : Score(sessionObjectiveId, playerId);

    private Task Score(Guid sessionObjectiveId, Guid playerId)
        => Store.Mutate(Store.Api.ScoreObjectiveAsync(Sid, sessionObjectiveId, playerId));

    // Taking a score back has no state to merge (the DELETE returns nothing), so it refreshes.
    private async Task Unscore(Guid sessionObjectiveId, Guid playerId)
    {
        await Store.Api.UnscoreObjectiveAsync(Sid, sessionObjectiveId, playerId);
        await Store.RefreshAsync();
    }

    // Red Tape: pull the tape off an objective so it can be scored (the card asks for a second tap first).
    private Task RemoveTape(Guid sessionObjectiveId)
        => Store.Mutate(Store.Api.SetObjectiveMarkerAsync(Sid, sessionObjectiveId, true));
}
