@* The TE "Sprecher" speaker token (recreated as wwwroot/speaker.svg). Used wherever the speaker is
   marked, in place of a star. Size via SizeCss (height; width auto). *@
<img src="speaker.svg" class="speaker-icon" alt="@Loc["players.speaker"]" title='@Loc["players.speaker"]'
     style="@(SizeCss is null ? null : $"height:{SizeCss}")" />

@code {
    [Parameter] public string? SizeCss { get; set; }
    [Inject] private Loc Loc { get; set; } = default!;
}
