@* The TE "Sprecher" speaker token (wwwroot/speaker.png — the image already contains the word
   "SPRECHER", so it's shown on its own with no text label beside it). Used wherever the speaker is
   marked, in place of a star. Size via SizeCss (height; width auto keeps the wide aspect). *@
<img src="speaker.png" class="speaker-icon" alt="@Loc["players.speaker"]" title='@Loc["players.speaker"]'
     style="@(SizeCss is null ? null : $"height:{SizeCss}")" />

@code {
    [Parameter] public string? SizeCss { get; set; }
    [Inject] private Loc Loc { get; set; } = default!;
}
