@inherits Ti4ComponentBase
@inject IJSRuntime JS

@{
    var s = Store.Session!;
    var allReady = s.Players.Count > 0 && s.Players.All(p => p.IsReady);
    var allPassed = s.Players.Count > 0 && s.Players.All(p => p.HasPassed);
    var speakerSet = s.SpeakerPlayerId is not null;
    // Action phase can't begin until everyone has their full strategy-card allotment.
    var allPicked = s.Players.Count > 0 && s.Players.All(p => p.StrategyCards.Count >= Store.MaxStrategyCards);
    var host = Store.IsHost;
}

<div class="panel phase-bar">
    @* In-game phases as a connected leiste (Setup is intentionally not a segment). During setup the
       leiste is hidden and the ready count is shown instead. *@
    @if (s.Phase == GamePhase.Setup)
    {
        <div class="phase-ready">@Loc["setup.readyCount"]: <strong>@s.Players.Count(p => p.IsReady)/@s.Players.Count</strong></div>
    }
    else
    {
        <div class="phase-leiste">
            @foreach (var ph in new[] { GamePhase.Strategy, GamePhase.Action, GamePhase.Status, GamePhase.Agenda })
            {
                <div class="pseg @(s.Phase == ph ? "on" : (int)s.Phase > (int)ph ? "done" : "")">@Loc[$"phase.{ph}"]</div>
            }
        </div>
    }
    <div class="spacer" style="flex:1"></div>
    <div class="row-wrap" style="gap:.4rem;align-items:center;">
        @* Phase transitions are reserved for the host. *@
        @if (!host)
        {
            <span class="faint">@Loc["host.onlyHint"]</span>
        }
        else
        {
            switch (s.Phase)
            {
                case GamePhase.Setup:
                    @* The speaker is NOT a gate anymore — it is settled in the seat dialog (or later at the
                       table), so a game can start while that is still being argued about. *@
                    <button class="btn btn-gold" disabled="@(!allReady)" @onclick="() => showSeatConfirm = true">@Loc["turn.startGame"] ▸</button>
                    break;
                case GamePhase.Strategy:
                    @if (!allPicked) { <span class="faint">@Loc["strategy.needAllPicks"]</span> }
                    <button class="btn btn-primary" disabled="@(!allPicked)" @onclick="ToAction">@Loc["turn.toAction"] ▸</button>
                    break;
                case GamePhase.Action:
                    <button class="btn btn-gold" disabled="@(!allPassed)" @onclick="EndAction">@Loc["turn.endAction"]</button>
                    break;
                case GamePhase.Status:
                    <button class="btn" @onclick="ToAgenda">@Loc["turn.toAgenda"]</button>
                    <button class="btn btn-gold" @onclick="NextRound">⟳ @Loc["turn.nextRound"]</button>
                    break;
                case GamePhase.Agenda:
                    <button class="btn btn-gold" @onclick="NextRound">@Loc["agenda.end"] ▸</button>
                    break;
            }
        }
    </div>
</div>

@* Seat-order confirmation before the game actually starts: shows the order around the table so the
   host double-checks it — and lets them fix it right here by dragging, instead of closing the dialog and
   going back to the player list. "Change it" just closes (nothing is started). *@
@if (showSeatConfirm && s.Phase == GamePhase.Setup)
{
    <div class="modal-backdrop centered blurred" @onclick="CloseSeatConfirm">
        <div class="modal seat-confirm" @onclick:stopPropagation>
            <div class="modal-head">
                <h3 style="margin:0;">@Loc["setup.confirmSeatTitle"]</h3>
            </div>
            <div class="modal-body">
                @{ var seatOrdered = SeatOrdered(s); }
                <div class="grid seat-list" style="gap:.35rem;margin:.6rem 0;" @ref="seatList">
                    @for (var i = 0; i < seatOrdered.Count; i++)
                    {
                        var p = seatOrdered[i];
                        var idx = i;
                        <div @key="p.Id" class="player-card seat-confirm-row @(dragFrom == idx ? "dragging" : "")"
                             style="--player-color:@p.ColorHex;" data-seat-idx="@idx">
                            <span class="seat-grip" data-seat-grip title='@Loc["setup.dragSeat"]'>⠿</span>
                            <span class="seat-no">@(i + 1)</span>
                            <FactionBadge Faction="Store.Faction(p.FactionId)" Size="1.6" Ring="@p.ColorHex" />
                            <strong style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;">@p.Name</strong>
                            @* The speaker is chosen right here — it decides who picks first, so this is the
                               screen where it matters. Tapping a row's token makes that player speaker. *@
                            @{ var pid = p.Id; }
                            <button class="btn btn-sm seat-speaker @(s.SpeakerPlayerId == p.Id ? "btn-gold" : "btn-ghost")"
                                    @onclick="() => SetSpeaker(pid)" title='@Loc["setup.makeSpeaker"]'>
                                @if (s.SpeakerPlayerId == p.Id) { <SpeakerIcon SizeCss="1.3em" /> }
                                else { <span class="ss-dash">—</span> }
                            </button>
                            @* Arrow fallback: always works, including where a drag is awkward. *@
                            <span class="seat-arrows">
                                <button class="btn btn-sm btn-ghost" disabled="@(idx == 0)" @onclick="() => Nudge(idx, -1)" title='@Loc["setup.moveUp"]'>▲</button>
                                <button class="btn btn-sm btn-ghost" disabled="@(idx == seatOrdered.Count - 1)" @onclick="() => Nudge(idx, 1)" title='@Loc["setup.moveDown"]'>▼</button>
                            </span>
                        </div>
                    }
                </div>
                <div class="row-wrap" style="gap:.5rem;align-items:center;margin:.2rem 0 .6rem;">
                    <span class="faint" style="font-size:.78rem;">@Loc[speakerSet ? "setup.speakerLbl" : "setup.noSpeakerYet"]</span>
                    <button class="btn btn-sm" @onclick="RandomSpeaker">🎲 @Loc["setup.randomSpeaker"]</button>
                </div>
                <p class="faint" style="font-size:.78rem;margin:.2rem 0 .8rem;">@Loc["setup.confirmSeatDragHint"]</p>
                <div class="row-wrap" style="gap:.5rem;justify-content:flex-end;">
                    <button class="btn" @onclick="CloseSeatConfirm">◂ @Loc["setup.confirmSeatChange"]</button>
                    <button class="btn btn-gold" @onclick="ConfirmStart">@Loc["setup.confirmSeatOk"] ▸</button>
                </div>
            </div>
        </div>
    </div>
}

@switch (s.Phase)
{
    case GamePhase.Setup:
        <SetupView />
        break;
    case GamePhase.Strategy:
        <StrategyView />
        break;
    case GamePhase.Action:
        <ActionView />
        break;
    case GamePhase.Status:
        <StatusView />
        break;
    case GamePhase.Agenda:
        <AgendaView />
        break;
}

@code {
    private Guid Sid => Store.Session!.Id;
    private bool showSeatConfirm;

    // ---- Seat order: drag to reorder inside the confirmation dialog ------------------------------
    // `preview` holds the order while a drag is in flight, so the rows follow the finger without a
    // server roundtrip per pixel; it is committed on release and then dropped so the server state wins.
    private ElementReference seatList;
    private DotNetObjectReference<PhaseView>? selfRef;
    private IJSObjectReference? dragHandle;
    private List<Guid>? preview;
    private int dragFrom = -1;

    private List<PlayerDto> SeatOrdered(SessionStateDto s)
    {
        var byId = s.Players.ToDictionary(p => p.Id);
        if (preview is not null && preview.Count == s.Players.Count && preview.All(byId.ContainsKey))
            return preview.Select(id => byId[id]).ToList();
        return s.Players.OrderBy(p => p.SeatOrder).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showSeatConfirm && dragHandle is null)
        {
            selfRef ??= DotNetObjectReference.Create(this);
            dragHandle = await JS.InvokeAsync<IJSObjectReference>("ti4.seatDrag", seatList, selfRef);
        }
        else if (!showSeatConfirm && dragHandle is not null)
        {
            await DisposeDragAsync();
        }
    }

    [JSInvokable]
    public void DragStart(int index) => InvokeAsync(() =>
    {
        preview ??= Store.Session!.Players.OrderBy(p => p.SeatOrder).Select(p => p.Id).ToList();
        dragFrom = index;
        StateHasChanged();
    });

    [JSInvokable]
    public void DragOver(int index) => InvokeAsync(() =>
    {
        if (preview is null || dragFrom < 0 || index == dragFrom || index >= preview.Count) return;
        var id = preview[dragFrom];
        preview.RemoveAt(dragFrom);
        preview.Insert(index, id);
        dragFrom = index;
        StateHasChanged();
    });

    [JSInvokable]
    public Task DragEnd() => InvokeAsync(async () =>
    {
        dragFrom = -1;
        await CommitSeatOrder();
    });

    private async Task Nudge(int index, int delta)
    {
        var order = SeatOrdered(Store.Session!).Select(p => p.Id).ToList();
        var target = index + delta;
        if (target < 0 || target >= order.Count) return;
        (order[index], order[target]) = (order[target], order[index]);
        preview = order;
        await CommitSeatOrder();
    }

    private async Task CommitSeatOrder()
    {
        if (preview is null) return;
        var order = preview;
        await Store.Mutate(Store.Api.SetSeatOrderAsync(Sid, order));
        preview = null; // server state takes over again
    }

    private async Task CloseSeatConfirm()
    {
        showSeatConfirm = false;
        preview = null;
        dragFrom = -1;
        await DisposeDragAsync();
    }

    private async Task DisposeDragAsync()
    {
        if (dragHandle is null) return;
        try { await dragHandle.InvokeVoidAsync("dispose"); } catch { }
        try { await dragHandle.DisposeAsync(); } catch { }
        dragHandle = null;
    }

    public override void Dispose()
    {
        selfRef?.Dispose();
        base.Dispose();
    }

    private Task SetSpeaker(Guid playerId)
        => Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(null, null, null, null, null, null, null, playerId)));

    // Nobody wants to argue about who goes first. Random.Shared is fine here — this is a seating decision,
    // not a shuffle anyone could gain from predicting.
    private Task RandomSpeaker()
    {
        var players = Store.Session!.Players;
        if (players.Count == 0) return Task.CompletedTask;
        return SetSpeaker(players[Random.Shared.Next(players.Count)].Id);
    }

    private async Task ConfirmStart() { await CloseSeatConfirm(); await StartGame(); }
    private Task StartGame() => Store.Mutate(Store.Api.StartGameAsync(Sid));
    private Task ToAction() => Store.Mutate(Store.Api.StartActionPhaseAsync(Sid));
    private Task EndAction() => Store.Mutate(Store.Api.EndActionPhaseAsync(Sid));
    private Task ToAgenda() => Store.Mutate(Store.Api.StartAgendaPhaseAsync(Sid));
    private Task NextRound() => Store.Mutate(Store.Api.NextRoundAsync(Sid));
}
