@inherits Ti4ComponentBase
@inject IJSRuntime JS

@{
    var s = Store.Session!;
    var allReady = s.Players.Count > 0 && s.Players.All(p => p.IsReady);
    var allPassed = s.Players.Count > 0 && s.Players.All(p => p.HasPassed);
    var speakerSet = s.SpeakerPlayerId is not null;
    // Action phase can't begin until everyone has their full strategy-card allotment — or the eight cards
    // have run out, which is the only way a five-player table playing "two each" ever gets there.
    var allPicked = Store.StrategyPickDone;
    var host = Store.IsHost;
}

@* The whole bar is gone during setup (2026-08-12, on request): it had nothing left to say there. The phases
   have not started, the "start" button lives on the last setup step, and the ready count sits in the setup
   navigation for the host and above the player list for everyone else (see SetupView). *@
@if (s.Phase != GamePhase.Setup)
{
<div class="panel phase-bar">
    @* In-game phases as a connected leiste (Setup is intentionally not a segment). *@
    <div class="phase-leiste">
        @foreach (var ph in new[] { GamePhase.Strategy, GamePhase.Action, GamePhase.Status, GamePhase.Agenda })
        {
            <div class="pseg @(s.Phase == ph ? "on" : (int)s.Phase > (int)ph ? "done" : "")">@Loc[$"phase.{ph}"]</div>
        }
    </div>
    <div class="spacer" style="flex:1"></div>
    <div class="row-wrap" style="gap:.4rem;align-items:center;">
        @* Phase transitions are reserved for the host. *@
        @if (!host)
        {
            <span class="faint">@Loc["host.onlyHint"]</span>
        }
        else
        {
            switch (s.Phase)
            {
                case GamePhase.Strategy:
                    @if (!allPicked) { <span class="faint">@Loc["strategy.needAllPicks"]</span> }
                    <button class="btn btn-primary" disabled="@(!allPicked)" @onclick="ToAction">@Loc["turn.toAction"] <MaterialIcon Name="chevron_right" /></button>
                    break;
                case GamePhase.Action:
                    <button class="btn btn-gold" disabled="@(!allPassed)" @onclick="EndAction">@Loc["turn.endAction"]</button>
                    break;
                case GamePhase.Status:
                    @* Both ways out of the status phase appear only on its LAST stage. Offered from the start,
                       they invite leaving before the table has scored and revealed — and the stage strip right
                       below says the phase has three steps, so a "next round" button next to step 1 is two
                       controls contradicting each other. Nothing is enforced: the host can still step back and
                       forth through the stages, and the buttons come back on the last one. *@
                    @if (s.StatusStage == StatusStage.Checklist)
                    {
                        <button class="btn" @onclick="ToAgenda">@Loc["turn.toAgenda"]</button>
                        <button class="btn btn-gold" @onclick="NextRound"><MaterialIcon Name="refresh" /> @Loc["turn.nextRound"]</button>
                    }
                    else
                    {
                        <span class="faint">@Loc["status.finishStages"]</span>
                    }
                    break;
                case GamePhase.Agenda:
                    <button class="btn btn-gold" @onclick="NextRound">@Loc["agenda.end"] <MaterialIcon Name="chevron_right" /></button>
                    break;
            }
        }
    </div>
</div>
}

@switch (s.Phase)
{
    case GamePhase.Setup:
        <SetupView />
        break;
    case GamePhase.Strategy:
        <StrategyView />
        break;
    case GamePhase.Action:
        <ActionView />
        break;
    case GamePhase.Status:
        <StatusView />
        break;
    case GamePhase.Agenda:
        <AgendaView />
        break;
}

@code {
    private Guid Sid => Store.Session!.Id;

    // Starting the game moved to the last setup step (SetupView) together with the seat list, so neither the
    // button nor the confirmation dialog lives here any more.
    private Task ToAction() => Store.Mutate(Store.Api.StartActionPhaseAsync(Sid));
    private Task EndAction() => Store.Mutate(Store.Api.EndActionPhaseAsync(Sid));
    private Task ToAgenda() => Store.Mutate(Store.Api.StartAgendaPhaseAsync(Sid));
    private Task NextRound() => Store.Mutate(Store.Api.NextRoundAsync(Sid));
}
