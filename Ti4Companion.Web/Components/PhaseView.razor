@inherits Ti4ComponentBase

@{
    var s = Store.Session!;
    var allReady = s.Players.Count > 0 && s.Players.All(p => p.IsReady);
    var allPassed = s.Players.Count > 0 && s.Players.All(p => p.HasPassed);
    var speakerSet = s.SpeakerPlayerId is not null;
    // Action phase can't begin until everyone has their full strategy-card allotment.
    var allPicked = s.Players.Count > 0 && s.Players.All(p => p.StrategyCards.Count >= Store.MaxStrategyCards);
    var host = Store.IsHost;
}

<div class="panel phase-bar">
    @* In-game phases as a connected leiste (Setup is intentionally not a segment). During setup the
       leiste is hidden and the ready count is shown instead. *@
    @if (s.Phase == GamePhase.Setup)
    {
        <div class="phase-ready">@Loc["setup.readyCount"]: <strong>@s.Players.Count(p => p.IsReady)/@s.Players.Count</strong></div>
    }
    else
    {
        <div class="phase-leiste">
            @foreach (var ph in new[] { GamePhase.Strategy, GamePhase.Action, GamePhase.Status, GamePhase.Agenda })
            {
                <div class="pseg @(s.Phase == ph ? "on" : (int)s.Phase > (int)ph ? "done" : "")">@Loc[$"phase.{ph}"]</div>
            }
        </div>
    }
    <div class="spacer" style="flex:1"></div>
    <div class="row-wrap" style="gap:.4rem;align-items:center;">
        @* Phase transitions are reserved for the host. *@
        @if (!host)
        {
            <span class="faint">@Loc["host.onlyHint"]</span>
        }
        else
        {
            switch (s.Phase)
            {
                case GamePhase.Setup:
                    @if (!speakerSet) { <span class="faint">@Loc["setup.needSpeaker"]</span> }
                    <button class="btn btn-gold" disabled="@(!allReady || !speakerSet)" @onclick="StartGame">@Loc["turn.startGame"] ▸</button>
                    break;
                case GamePhase.Strategy:
                    @if (!allPicked) { <span class="faint">@Loc["strategy.needAllPicks"]</span> }
                    <button class="btn btn-primary" disabled="@(!allPicked)" @onclick="ToAction">@Loc["turn.toAction"] ▸</button>
                    break;
                case GamePhase.Action:
                    <button class="btn btn-gold" disabled="@(!allPassed)" @onclick="EndAction">@Loc["turn.endAction"]</button>
                    break;
                case GamePhase.Status:
                    <button class="btn" @onclick="ToAgenda">@Loc["turn.toAgenda"]</button>
                    <button class="btn btn-gold" @onclick="NextRound">⟳ @Loc["turn.nextRound"]</button>
                    break;
                case GamePhase.Agenda:
                    <button class="btn btn-gold" @onclick="NextRound">@Loc["agenda.end"] ▸</button>
                    break;
            }
        }
    </div>
</div>

@switch (s.Phase)
{
    case GamePhase.Setup:
        <SetupView />
        break;
    case GamePhase.Strategy:
        <StrategyView />
        break;
    case GamePhase.Action:
        <ActionView />
        break;
    case GamePhase.Status:
        <StatusView />
        break;
    case GamePhase.Agenda:
        <AgendaView />
        break;
}

@code {
    private Guid Sid => Store.Session!.Id;
    private Task StartGame() => Store.Mutate(Store.Api.StartGameAsync(Sid));
    private Task ToAction() => Store.Mutate(Store.Api.StartActionPhaseAsync(Sid));
    private Task EndAction() => Store.Mutate(Store.Api.EndActionPhaseAsync(Sid));
    private Task ToAgenda() => Store.Mutate(Store.Api.StartAgendaPhaseAsync(Sid));
    private Task NextRound() => Store.Mutate(Store.Api.NextRoundAsync(Sid));
}
