@inherits Ti4ComponentBase

@*
    The start page's backdrop: the senate chamber as a BOWL, seen from above, turning very slowly.

    Three things make it work, and each was got wrong first:

    1. It is a funnel, not a sphere: every ring sits higher AND further out than the one below, leans in
       towards the middle and is drawn a little smaller. That is the shape in the reference cutaway — the rings
       fan open towards the viewer instead of wrapping back over their head.

    2. The whole ring stays BEHIND the perspective plane (see `.senate-scene` in app.css). CSS magnifies by
       `perspective / distance`, without bound as a seat approaches the camera plane — and a ring drawn *around*
       the camera necessarily crosses it. One seat came out 15557px wide that way.

    3. No portrait is ever seen from behind: the near half of every ring faces the bowl's axis, i.e. away from
       us, and `backface-visibility: hidden` simply doesn't paint it. What is left is the far half stepping up.

    Rings are offset by half a seat against each other, so the pods interlock:

        X X X X X X X
         X X X X X X X

    `pointer-events: none` throughout: it is a backdrop, and nothing on it may ever eat a tap meant for the
    buttons in front.
*@
<div class="senate" aria-hidden="true">
    <div class="senate-scene">
        @for (var row = 0; row < Rows; row++)
        {
            // Up and out: the funnel widens with every row, and the seats shrink as they climb.
            // The Y value is emitted SIGNED (screen coordinates, so negative = up). Writing `-{lift}` instead
            // produced `translateY(--14vmin)` for the bottom row, which is not a valid transform — the whole
            // declaration was dropped and that row landed on the camera, filling the screen.
            var radius = FormattableString.Invariant($"{BaseRadius + row * RadiusStep:0.##}");
            var lift = FormattableString.Invariant($"{FirstRowDrop - row * HeightStep:0.##}");
            var tilt = FormattableString.Invariant($"{row * TiltStep:0.##}");
            var scale = FormattableString.Invariant($"{1.0 - row * ScaleStep:0.###}");
            var offset = row % 2 == 1 ? 0.5 : 0.0;   // every other row shifted by half a seat
            for (var col = 0; col < Cols; col++)
            {
                // A FULL ring per row. The seats on the near side face the bowl's axis, i.e. away from us, and
                // `backface-visibility: hidden` drops them — which is what keeps their backs off the screen
                // while the far side steps up into view.
                var yaw = FormattableString.Invariant($"{(col + offset) * (360.0 / Cols):0.##}");
                var slug = Slugs[(row * Cols + col) % Slugs.Count];
                // Order matters: yaw puts the seat on the ring, translateY lifts it, translateZ pushes it out
                // along the yawed axis (so it already faces the centre), and rotateX then tilts it in place
                // towards the viewer below. Scale last, so it doesn't scale the offsets with it.
                <div class="senate-seat"
                     style="@FormattableString.Invariant($"transform: rotateY({yaw}deg) translateY({lift}vmin) translateZ(-{radius}vmin) rotateX({tilt}deg) scale({scale});")">
                    @* The pod itself: a dark shell with a lit rim along its lower edge and the delegate inside
                       it. All CSS — see `.pod*` in app.css. No loading="lazy" on the portrait: the seats are
                       transformed far outside the viewport's own coordinates, so the browser never considers
                       them near enough to fetch and the chamber stayed empty. *@
                    <div class="pod">
                        <img class="pod-face" src="@($"portraits/{slug}.jpg")" alt="" />
                        <span class="pod-rim"></span>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    // Funnel geometry, in vmin so it scales with the window.
    private const int Rows = 8;
    private const int Cols = 20;            // a full ring; roughly half of it faces us at any time
    private const double BaseRadius = 26;   // innermost ring (around the podium)
    private const double RadiusStep = 13;   // each ring further out …
    private const double HeightStep = 10;    // … and a step higher: a shallow bowl, as in the reference
    private const double FirstRowDrop = 0;
    private const double TiltStep = 6;      // degrees each ring leans in towards the middle
    private const double ScaleStep = 0.05;  // slightly smaller per ring, on top of what perspective does

    /// <summary>
    /// The portrait files used for the seats — file NAMES, not all of them faction slugs (barony/cabal/ghosts).
    /// Hard-coded because the client cannot stat files, and a missing image would leave a hole in the chamber.
    /// <para>
    /// Deliberately a SUBSET of the 24 portraits that exist: each is ~50 KB, and this is decoration on a
    /// landing page — twelve is ~600 KB instead of ~1.2 MB, and nobody can tell that a slowly turning chamber
    /// repeats a face. They are the same files the agenda wall uses, so a returning visitor has them cached.
    /// </para>
    /// </summary>
    private static readonly List<string> Slugs = new()
    {
        "sol", "hacan", "jolnar", "xxcha", "mentak", "naalu",
        "muaat", "sardakk", "arborec", "yssaril", "nekro", "titans",
    };
}
