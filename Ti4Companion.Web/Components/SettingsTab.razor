@inherits Ti4ComponentBase
@inject NavigationManager Nav

@{
    var s = Store.Session!;
    bool Has(Expansion e) => (s.ActiveExpansions & e) != 0;
}

@if (!Store.IsHost)
{
    <div class="panel"><p class="muted" style="margin:0;">@Loc["host.onlyHint"]</p></div>
    return;
}

<div class="panel">
    <h3>@Loc["settings.title"]</h3>

    <div class="field">
        <label>@Loc["settings.language"]</label>
        <div class="row-wrap">
            <button class="btn btn-sm @(s.DefaultLanguage == Language.En ? "btn-gold" : "")" @onclick="() => SetLang(Language.En)">English</button>
            <button class="btn btn-sm @(s.DefaultLanguage == Language.De ? "btn-gold" : "")" @onclick="() => SetLang(Language.De)">Deutsch</button>
        </div>
    </div>

    <div class="field">
        <label>@Loc["settings.expansions"]</label>
        <div class="row-wrap">
            <label class="badge"><input type="checkbox" checked disabled /> &nbsp;@Loc["exp.Base"]</label>
            <label class="badge"><input type="checkbox" checked="@Has(Expansion.ProphecyOfKings)" @onchange="e => SetExp(Expansion.ProphecyOfKings, e)" /> &nbsp;@Loc["exp.ProphecyOfKings"]</label>
            <label class="badge"><input type="checkbox" checked="@Has(Expansion.Codex)" @onchange="e => SetExp(Expansion.Codex, e)" /> &nbsp;@Loc["exp.Codex"]</label>
            <label class="badge"><input type="checkbox" checked="@Has(Expansion.ThundersEdge)" @onchange="e => SetExp(Expansion.ThundersEdge, e)" /> &nbsp;@Loc["exp.ThundersEdge"]</label>
        </div>
    </div>

    <div class="field">
        <label class="badge" style="font-size:.9rem;">
            <input type="checkbox" checked="@s.AllowEditAllPlayers" @onchange="ToggleEditAll" /> &nbsp;@Loc["settings.editAll"]
        </label>
        <p class="faint" style="font-size:.78rem;margin-top:.3rem;">@Loc["settings.editAllHint"]</p>
    </div>

    <p class="faint" style="font-size:.78rem;">@Loc["settings.retentionInfo"]</p>
</div>

<div class="panel">
    @if (!confirmDelete)
    {
        <button class="btn btn-danger" @onclick="() => confirmDelete = true">@Loc["settings.delete"]</button>
    }
    else
    {
        <p>@Loc["settings.deleteConfirm"]</p>
        <div class="row-wrap">
            <button class="btn btn-danger" @onclick="Delete">@Loc["settings.delete"]</button>
            <button class="btn btn-ghost" @onclick="() => confirmDelete = false">@Loc["common.cancel"]</button>
        </div>
    }
</div>

@code {
    private Guid Sid => Store.Session!.Id;
    private bool confirmDelete;

    private Task SetLang(Language lang)
        => Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(null, lang, null, null, null, null, null, null)));

    private Task ToggleEditAll(ChangeEventArgs e)
        => Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(null, null, null, null, e.Value is bool b && b, null, null, null)));

    private Task SetExp(Expansion exp, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        var current = Store.Session!.ActiveExpansions;
        var updated = on ? current | exp : current & ~exp;
        return Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(null, null, updated, null, null, null, null, null)));
    }

    private async Task Delete()
    {
        await Store.Api.DeleteSessionAsync(Sid);
        await Store.LeaveAsync();
        Nav.NavigateTo("/");
    }
}
