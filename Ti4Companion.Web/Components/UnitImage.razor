@* Placeholder unit-upgrade image (original SVG). Real per-unit art can replace this later, keyed off
   the unit type from units.csv; for now every unit upgrade shows this generic framed silhouette. *@

<div class="unit-img" title="@Label" style="width:@(Size)px;height:@(Size)px;">
    <svg viewBox="0 0 48 48" role="img" aria-label="@Label" style="width:100%;height:100%;">
        <rect x="1" y="1" width="46" height="46" rx="8" fill="#0c1428" stroke="var(--panel-border)" stroke-width="1.5" />
        <path d="M24 9 L34 30 L24 25 L14 30 Z" fill="#36507e" stroke="#5a7cb0" stroke-width="1" stroke-linejoin="round" />
        <circle cx="24" cy="20" r="2.6" fill="#9fc0ef" />
        <path d="M16 33 L32 33" stroke="#2a3a5c" stroke-width="2" stroke-linecap="round" />
        <text x="24" y="44" text-anchor="middle" font-size="7" fill="var(--text-faint)" font-family="Rajdhani, sans-serif">UNIT</text>
    </svg>
</div>

@code {
    [Parameter] public int Size { get; set; } = 44;
    [Parameter] public string? Label { get; set; } = "Unit upgrade";
}
