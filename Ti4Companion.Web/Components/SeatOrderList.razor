@inherits Ti4ComponentBase
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    The table in seat order: drag a row by its grip (or use the arrows) to reorder, tap a row's token to make
    that player speaker, or roll for one.

    Used twice — as the setup's seating step and inside the "is the seating right?" dialog before the game
    starts — which is why it is a component and not markup in both places.

    Reordering uses POINTER events, never the HTML5 drag events: those don't fire on touch and the device that
    runs the table is an iPad. `ti4.seatDrag` only reports which row the pointer is over; Blazor keeps owning
    the DOM and re-renders the preview order, so JS never moves a node behind its diff's back.
*@
<div class="grid seat-list" style="gap:.35rem;" @ref="seatList">
    @{ var seatOrdered = SeatOrdered(); }
    @for (var i = 0; i < seatOrdered.Count; i++)
    {
        var p = seatOrdered[i];
        var idx = i;
        var pid = p.Id;
        <div @key="p.Id" class="player-card seat-confirm-row @(dragFrom == idx ? "dragging" : "")"
             style="--player-color:@p.ColorHex;" data-seat-idx="@idx">
            <span class="seat-grip" data-seat-grip title='@Loc["setup.dragSeat"]'>⠿</span>
            <span class="seat-no">@(i + 1)</span>
            <FactionBadge Faction="Store.Faction(p.FactionId)" Size="1.6" Ring="@p.ColorHex" />
            <strong style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;">@p.Name</strong>
            @* The speaker decides who picks first, so it belongs on the screen where the order is settled. *@
            <button class="btn btn-sm seat-speaker @(Store.Session!.SpeakerPlayerId == p.Id ? "btn-gold" : "btn-ghost")"
                    @onclick="() => SetSpeaker(pid)" title='@Loc["setup.makeSpeaker"]'>
                @if (Store.Session!.SpeakerPlayerId == p.Id) { <SpeakerIcon SizeCss="1.3em" /> }
                else { <span class="ss-dash">—</span> }
            </button>
            @* Arrow fallback: always works, including where a drag is awkward. *@
            <span class="seat-arrows">
                <button class="btn btn-sm btn-ghost" disabled="@(idx == 0)" @onclick="() => Nudge(idx, -1)" title='@Loc["setup.moveUp"]'>▲</button>
                <button class="btn btn-sm btn-ghost" disabled="@(idx == seatOrdered.Count - 1)" @onclick="() => Nudge(idx, 1)" title='@Loc["setup.moveDown"]'>▼</button>
            </span>
        </div>
    }
</div>
<div class="row-wrap" style="gap:.5rem;align-items:center;margin:.5rem 0 0;">
    <span class="faint" style="font-size:.78rem;">@Loc[Store.Session!.SpeakerPlayerId is null ? "setup.noSpeakerYet" : "setup.speakerLbl"]</span>
    <button class="btn btn-sm" @onclick="RandomSpeaker">🎲 @Loc["setup.randomSpeaker"]</button>
</div>
<p class="faint" style="font-size:.78rem;margin:.4rem 0 0;">@Loc["setup.confirmSeatDragHint"]</p>

@code {
    private Guid Sid => Store.Session!.Id;

    // `preview` holds the order while a drag is in flight, so the rows follow the finger without a server
    // roundtrip per pixel; it is committed on release and then dropped so the server state wins again.
    private ElementReference seatList;
    private DotNetObjectReference<SeatOrderList>? selfRef;
    private IJSObjectReference? dragHandle;
    private List<Guid>? preview;
    private int dragFrom = -1;

    private List<PlayerDto> SeatOrdered()
    {
        var s = Store.Session!;
        var byId = s.Players.ToDictionary(p => p.Id);
        if (preview is not null && preview.Count == s.Players.Count && preview.All(byId.ContainsKey))
            return preview.Select(id => byId[id]).ToList();
        return s.Players.OrderBy(p => p.SeatOrder).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (dragHandle is null)
        {
            selfRef ??= DotNetObjectReference.Create(this);
            dragHandle = await JS.InvokeAsync<IJSObjectReference>("ti4.seatDrag", seatList, selfRef);
        }
    }

    [JSInvokable]
    public void DragStart(int index) => InvokeAsync(() =>
    {
        preview ??= Store.Session!.Players.OrderBy(p => p.SeatOrder).Select(p => p.Id).ToList();
        dragFrom = index;
        StateHasChanged();
    });

    [JSInvokable]
    public void DragOver(int index) => InvokeAsync(() =>
    {
        if (preview is null || dragFrom < 0 || index == dragFrom || index >= preview.Count) return;
        var id = preview[dragFrom];
        preview.RemoveAt(dragFrom);
        preview.Insert(index, id);
        dragFrom = index;
        StateHasChanged();
    });

    [JSInvokable]
    public Task DragEnd() => InvokeAsync(async () =>
    {
        dragFrom = -1;
        await CommitSeatOrder();
    });

    private async Task Nudge(int index, int delta)
    {
        var order = SeatOrdered().Select(p => p.Id).ToList();
        var target = index + delta;
        if (target < 0 || target >= order.Count) return;
        (order[index], order[target]) = (order[target], order[index]);
        preview = order;
        await CommitSeatOrder();
    }

    private async Task CommitSeatOrder()
    {
        if (preview is null) return;
        var order = preview;
        await Store.Mutate(Store.Api.SetSeatOrderAsync(Sid, order));
        preview = null; // server state takes over again
    }

    private Task SetSpeaker(Guid playerId)
        => Store.Mutate(Store.Api.UpdateSessionAsync(Sid, new UpdateSessionRequest(null, null, null, null, null, null, null, playerId)));

    // Nobody wants to argue about who goes first. Random.Shared is fine — this is a seating decision, not a
    // shuffle anyone could gain from predicting.
    private Task RandomSpeaker()
    {
        var players = Store.Session!.Players;
        if (players.Count == 0) return Task.CompletedTask;
        return SetSpeaker(players[Random.Shared.Next(players.Count)].Id);
    }

    public async ValueTask DisposeAsync()
    {
        if (dragHandle is not null)
        {
            try { await dragHandle.InvokeVoidAsync("dispose"); } catch { }
            try { await dragHandle.DisposeAsync(); } catch { }
            dragHandle = null;
        }
        selfRef?.Dispose();
        Dispose();
    }
}
