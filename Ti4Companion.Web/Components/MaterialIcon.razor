@inherits Ti4ComponentBase

@*
    Google Material Symbols, inlined.

    Inlined rather than loaded as a font or an <img>: the wall display has to work on a LAN with no
    internet, and the app's CSP blocks fetched resources anyway. Paths are the unmodified 24px outlined
    symbols from github.com/google/material-design-icons (Apache License 2.0) — hence the odd but
    original `0 -960 960 960` viewBox. Credited in the footer.

    Sized in `em` so an icon follows the surrounding text, and filled with `currentColor` so it takes
    the button's colour (including the hover/disabled states) without extra rules.
*@
<svg class="micon @Class" viewBox="0 -960 960 960" style="@SizeStyle" fill="currentColor"
     aria-hidden="true" focusable="false"><path d="@Path" /></svg>

@code {
    /// <summary>Icon name, one of the keys in <see cref="Paths"/>.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Any CSS length; defaults to 1.15em (a shade larger than the text, like Material's own guidance).</summary>
    [Parameter] public string SizeCss { get; set; } = "1.15em";

    [Parameter] public string? Class { get; set; }

    private string SizeStyle => $"width:{SizeCss};height:{SizeCss};";

    private string Path => Paths.TryGetValue(Name, out var d) ? d : "";

