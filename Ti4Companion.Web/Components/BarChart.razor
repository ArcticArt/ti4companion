@using System.Globalization
@* Horizontal bar chart. Items: (Label, ValueText, Weight, Color); the bar width is Weight / max. *@
<div class="bar-chart">
    @{ var max = Items.Count == 0 ? 1.0 : Math.Max(1.0, Items.Max(i => i.Weight)); }
    @foreach (var it in Items)
    {
        <div class="bar-row">
            <span class="bar-label">@it.Label</span>
            <span class="bar-track"><span class="bar-fill" style="width:@Pct(it.Weight, max)%;background:@it.Color"></span></span>
            <span class="bar-val">@it.ValueText</span>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<(string Label, string ValueText, double Weight, string Color)> Items { get; set; }
        = Array.Empty<(string, string, double, string)>();

    private static string Pct(double v, double max) => (max <= 0 ? 0 : v / max * 100).ToString("0.#", CultureInfo.InvariantCulture);
}
