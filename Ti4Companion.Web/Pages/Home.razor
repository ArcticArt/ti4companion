@page "/"
@page "/join/{Code}"
@inherits Ti4ComponentBase
@inject NavigationManager Nav

<PageTitle>Twilight Imperium Companion</PageTitle>

@* The senate chamber behind everything (see SenateBackdrop). On EVERY view of the start page — restricting it
   to the landing view meant the background simply vanished when you opened "create session" — and off
   entirely when this device has said so (Store.SenateEnabled, remembered). *@
@if (Store.SenateEnabled)
{
    <SenateBackdrop />
}

<div class="container home-view">
    @* The application's own name, above the form — it used to be a small link in the app bar, which is not
       where a landing page introduces itself. *@
    <h1 class="app-title">@Loc["app.title"]</h1>

    @if (view == View.Landing)
    {
        <div class="panel home-panel" style="text-align:center;">
            @* Heading and choices are one stack of equally sized rows — the heading is the label of the menu,
               not a title above it. See `.home-choice`. *@
            <div class="home-choice">
                <h2>@Loc["home.welcome"]</h2>
                <button class="btn btn-primary" @onclick="() => view = View.Create">@Loc["home.createSession"]</button>
                <button class="btn btn-gold" @onclick="() => view = View.Join">@Loc["home.joinSession"]</button>
                @* A fixed third entry, shown even with nothing to resume: the menu should not change shape
                   between devices, and the list says for itself when it is empty. *@
                <button class="btn" @onclick="() => view = View.Recent">@Loc["home.recent"]</button>
            </div>
            @* The backdrop switch. Deliberately BELOW the stack and small: it is a setting about the page, not
               one of the ways into a game, and the four rows above should stay the choice. *@
            <button class="btn btn-ghost btn-sm home-senate-toggle"
                    @onclick="() => Store.SetSenateAsync(!Store.SenateEnabled)">
                @Loc[Store.SenateEnabled ? "home.senateOff" : "home.senateOn"]
            </button>
        </div>
    }
    else if (view == View.Recent)
    {
        @* The sessions this DEVICE has played, newest first. Each row remembers which seat was ours there, so
           picking one up puts you back in your own player rather than joining as a stranger. *@
        <div class="panel home-form">
            <button class="btn btn-ghost btn-sm" @onclick="() => view = View.Landing">◂ @Loc["home.back"]</button>
            <h2 style="margin-top:.5rem;">@Loc["home.recentTitle"]</h2>
            @if (recent.Count == 0)
            {
                <p class="faint">@Loc["home.recentNone"]</p>
            }
            <div class="join-players">
                @foreach (var r in recent)
                {
                    <button class="join-player" disabled="@busy" @onclick="() => Resume(r.Code)">
                        <span class="rs-name">@(string.IsNullOrWhiteSpace(r.Name) ? Loc["home.recentUnnamed"] : r.Name)</span>
                        <span class="codechip">@r.Code</span>
                        @if (!string.IsNullOrWhiteSpace(r.PlayerName))
                        {
                            <span class="chip">@Loc["home.recentAs"] @r.PlayerName</span>
                        }
                    </button>
                }
            </div>
        </div>
    }
    else if (view == View.Create)
    {
        <div class="panel home-form">
            <button class="btn btn-ghost btn-sm" @onclick="() => view = View.Landing">◂ @Loc["home.back"]</button>
            <h2 style="margin-top:.5rem;">@Loc["home.createSession"]</h2>
            <div class="field">
                <label>@Loc["home.sessionName"]</label>
                <input type="text" @bind="sessionName" placeholder="Twilight Imperium" />
            </div>
            <div class="field">
                <label>@Loc["home.yourName"]</label>
                <input type="text" @bind="hostName" placeholder="@NamePlaceholder" />
            </div>
            @* No expansion picker here: it is the first thing the setup asks, and asking twice meant the
               start page could disagree with the session it just created. *@
            <button class="btn btn-primary btn-block" @onclick="Create" disabled="@busy">@Loc["home.create.button"]</button>
        </div>
    }
    else
    {
        <div class="panel home-form">
            <button class="btn btn-ghost btn-sm" @onclick="BackToLanding">◂ @Loc["home.back"]</button>
            <h2 style="margin-top:.5rem;">@Loc["home.joinSession"]</h2>
            <div class="field">
                <label>@Loc["home.joinCode"]</label>
                <input type="text" @bind="joinCode" @bind:event="oninput" placeholder="ABCDE" style="text-transform:uppercase;letter-spacing:.2em;" />
            </div>
            @* Join as a player, or open this code on a wall/beamer as the shared display. Two big targets with
               an icon each: this is the one choice on the page that decides what the device becomes. *@
            <div class="join-mode">
                <button class="btn @(joinAs == JoinMode.Player ? "btn-gold" : "")" @onclick="() => SetJoinAs(JoinMode.Player)">
                    <MaterialIcon Name="person" SizeCss="1.9em" />
                    <span>@Loc["home.asPlayer"]</span>
                </button>
                <button class="btn @(joinAs == JoinMode.Display ? "btn-gold" : "")" @onclick="() => SetJoinAs(JoinMode.Display)">
                    <MaterialIcon Name="tv" SizeCss="1.9em" />
                    <span>@Loc["home.asDisplay"]</span>
                </button>
            </div>
            @if (joinAs == JoinMode.Player)
            {
                @if (peek is null)
                {
                    @* Step 1: enter a code, then load the player list to choose an identity. *@
                    <button class="btn btn-primary btn-block" @onclick="LoadIdentities" disabled="@busy">@Loc["home.continue"]</button>
                }
                else
                {
                    @* Step 2: take over an existing player, or create a new one. *@
                    <p class="faint" style="margin:.2rem 0 .6rem;">@Loc["join.pickIdentity"]</p>
                    <div class="join-players">
                        @foreach (var jp in peek.Players.OrderBy(x => x.SeatOrder))
                        {
                            @* The host's seat is claimable too — a host whose browser lost its storage, or who
                               wants to carry on from another device, would otherwise leave the table with
                               nobody able to steer the phases. *@
                            <button class="join-player" disabled="@busy" @onclick="() => Claim(jp.Id)">
                                <FactionBadge Faction="Store.Faction(jp.FactionId)" Ring="@jp.ColorHex" />
                                <span class="jp-name">@jp.Name</span>
                                @if (jp.IsHost) { <span class="chip chip-active">@Loc["host.only"]</span> }
                                <span class="chip">@Loc[jp.IsHost ? "join.takeOverHost" : "join.takeOver"]</span>
                            </button>
                        }
                    </div>
                    @if (peek.Players.Count < 8)
                    {
                        <hr style="border-color:var(--panel-border);margin:.8rem 0;" />
                        <div class="field">
                            <label>@Loc["join.createNew"]</label>
                            <input type="text" @bind="joinName" placeholder="@NamePlaceholder" />
                        </div>
                        <button class="btn btn-primary btn-block" @onclick="Join" disabled="@busy">@Loc["join.createNew"]</button>
                    }
                    else
                    {
                        @* Session full (8 players): no create — take over above, or open the wall display. *@
                        <p class="faint" style="margin:.6rem 0;">@Loc["setup.maxPlayers"]</p>
                        <button class="btn btn-gold btn-block" @onclick="OpenDisplay" disabled="@busy">@Loc["home.openDisplay"]</button>
                    }
                }
            }
            else
            {
                <p class="faint" style="margin:.2rem 0 .8rem;">@Loc["home.displayHint"]</p>
                <button class="btn btn-gold btn-block" @onclick="OpenDisplay" disabled="@busy">@Loc["home.openDisplay"]</button>
            }
            @if (error is not null)
            {
                <p style="color:var(--danger);margin-top:.6rem;">@error</p>
            }
        </div>
    }

    @* How busy it is tonight: a notice about the instance between the form and the footer, never a field
       inside the form. Counts only, see ActivityDto; absent when the server didn't answer. *@
    @if (activity is { } act)
    {
        <div class="activity">
            <div class="activity-item">
                <span class="activity-num">@act.Active</span>
                <span class="activity-lbl">@Loc["home.activeNow"]</span>
            </div>
            <div class="activity-item">
                <span class="activity-num">@act.Last24h</span>
                <span class="activity-lbl">@Loc["home.active24h"]</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Code { get; set; }

    private enum View { Landing, Create, Join, Recent }
    private View view = View.Landing;
    private enum JoinMode { Player, Display }
    private JoinMode joinAs = JoinMode.Player;

    private string sessionName = "Twilight Imperium";
    private string hostName = "";
    private string joinCode = "";
    private string joinName = "";
    private bool busy;
    private string? error;
    private SessionStateDto? peek;   // the loaded session whose players you choose an identity from
    private ActivityDto? activity;   // counts for the landing view; null = the server didn't say
    private List<RecentSession> recent = new();   // sessions this device can pick up again

    private string NamePlaceholder => Loc["players.you"];

    protected override async Task OnInitializedAsync()
    {
        await Store.InitAsync();
        recent = await Store.RecentAsync();
        activity = await Store.Api.GetActivityAsync();
        // Arrived via an invite link (/join/{code}) → jump straight to the pre-filled join form.
        if (!string.IsNullOrWhiteSpace(Code))
        {
            joinCode = Code.Trim().ToUpperInvariant();
            view = View.Join;
        }
    }

    private async Task Create()
    {
        busy = true; error = null;
        try
        {
            // Null = "all of them", which the server turns into every expansion | Base. The table narrows it
            // down in the first setup step; a fresh session showing everything is the friendlier default.
            var req = new CreateSessionRequest(sessionName, Loc.Lang, null,
                string.IsNullOrWhiteSpace(hostName) ? "Host" : hostName, null, null, null);
            var s = await Store.CreateAsync(req);
            if (s is not null) Nav.NavigateTo($"/s/{s.JoinCode}");
        }
        finally { busy = false; }
    }

    // Step 1 → 2: load the session's player list so the joiner can pick who they are.
    private async Task LoadIdentities()
    {
        busy = true; error = null;
        try
        {
            var code = joinCode.Trim().ToUpperInvariant();
            if (string.IsNullOrWhiteSpace(code)) return;
            peek = await Store.Api.GetSessionAsync(code);
            if (peek is null) error = Loc["home.notfound"];
        }
        finally { busy = false; }
    }

    // Take over an existing seat.
    private async Task Claim(Guid playerId)
    {
        busy = true; error = null;
        try
        {
            var code = joinCode.Trim().ToUpperInvariant();
            // Empty name → keep the existing player's name (the server only renames on a non-empty name).
            var s = await Store.JoinAsync(code, new JoinSessionRequest("", null, null, null, playerId));
            if (s is null) { error = Loc["home.notfound"]; return; }
            Nav.NavigateTo($"/s/{s.JoinCode}");
        }
        finally { busy = false; }
    }

    // Create a brand-new player (only offered while the session has < 8 players).
    private async Task Join()
    {
        busy = true; error = null;
        try
        {
            var code = joinCode.Trim().ToUpperInvariant();
            if (string.IsNullOrWhiteSpace(code)) return;
            var s = await Store.JoinAsync(code, new JoinSessionRequest(
                string.IsNullOrWhiteSpace(joinName) ? "Player" : joinName, null, null, null));
            if (s is null) { error = Loc["home.notfound"]; return; }
            Nav.NavigateTo($"/s/{s.JoinCode}");
        }
        finally { busy = false; }
    }

    private void SetJoinAs(JoinMode m) { joinAs = m; peek = null; error = null; }
    private void BackToLanding() { view = View.Landing; peek = null; error = null; }

    // Open the entered code on this device as the shared wall display (no player join).
    private void OpenDisplay()
    {
        var code = joinCode.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(code)) { error = Loc["home.notfound"]; return; }
        Nav.NavigateTo($"/display/{code}");
    }

    // Pick a remembered session back up. Nothing to send: the session page connects by code and the store
    // looks up which seat this device held there (see SessionStore.ConnectAsync). A code that no longer
    // exists drops itself from the list on the way in.
    private void Resume(string code) => Nav.NavigateTo($"/s/{code}");
}
