@page "/"
@page "/join/{Code}"
@inherits Ti4ComponentBase
@inject NavigationManager Nav

<PageTitle>Twilight Imperium Companion</PageTitle>

<div class="container">
    @if (view == View.Landing)
    {
        <div class="panel" style="text-align:center;">
            <h2>@Loc["home.welcome"]</h2>
            <div class="row-wrap" style="justify-content:center;margin-top:1rem;">
                <button class="btn btn-primary" style="min-width:200px;" @onclick="() => view = View.Create">@Loc["home.createSession"]</button>
                <button class="btn btn-gold" style="min-width:200px;" @onclick="() => view = View.Join">@Loc["home.joinSession"]</button>
            </div>
            @if (lastCode is not null)
            {
                <div style="margin-top:1.2rem;">
                    <button class="btn btn-ghost" @onclick="ResumeLast">
                        @Loc["home.resume"] · <span class="codechip" style="font-size:.9rem;">@lastCode</span>
                    </button>
                </div>
            }
        </div>
    }
    else if (view == View.Create)
    {
        <div class="panel" style="max-width:480px;margin:0 auto;">
            <button class="btn btn-ghost btn-sm" @onclick="() => view = View.Landing">◂ @Loc["home.back"]</button>
            <h2 style="margin-top:.5rem;">@Loc["home.createSession"]</h2>
            <div class="field">
                <label>@Loc["home.sessionName"]</label>
                <input type="text" @bind="sessionName" placeholder="Twilight Imperium" />
            </div>
            <div class="field">
                <label>@Loc["home.yourName"]</label>
                <input type="text" @bind="hostName" placeholder="@NamePlaceholder" />
            </div>
            <div class="field">
                <label>@Loc["home.expansions"]</label>
                <div class="row-wrap">
                    <label class="badge"><input type="checkbox" checked disabled /> &nbsp;@Loc["exp.Base"]</label>
                    <label class="badge"><input type="checkbox" @bind="pok" /> &nbsp;@Loc["exp.ProphecyOfKings"]</label>
                    <label class="badge"><input type="checkbox" @bind="codex" /> &nbsp;@Loc["exp.Codex"]</label>
                    <label class="badge"><input type="checkbox" @bind="te" /> &nbsp;@Loc["exp.ThundersEdge"]</label>
                </div>
            </div>
            <button class="btn btn-primary btn-block" @onclick="Create" disabled="@busy">@Loc["home.create.button"]</button>
        </div>
    }
    else
    {
        <div class="panel" style="max-width:480px;margin:0 auto;">
            <button class="btn btn-ghost btn-sm" @onclick="() => view = View.Landing">◂ @Loc["home.back"]</button>
            <h2 style="margin-top:.5rem;">@Loc["home.joinSession"]</h2>
            <div class="field">
                <label>@Loc["home.joinCode"]</label>
                <input type="text" @bind="joinCode" placeholder="ABCDE" style="text-transform:uppercase;letter-spacing:.2em;" />
            </div>
            @* Join as a player, or open this code on a wall/beamer as the shared display. *@
            <div class="row-wrap" style="gap:.4rem;margin:.2rem 0 .8rem;">
                <button class="btn btn-sm @(joinAs == JoinMode.Player ? "btn-gold" : "")" @onclick="() => joinAs = JoinMode.Player">@Loc["home.asPlayer"]</button>
                <button class="btn btn-sm @(joinAs == JoinMode.Display ? "btn-gold" : "")" @onclick="() => joinAs = JoinMode.Display">@Loc["home.asDisplay"]</button>
            </div>
            @if (joinAs == JoinMode.Player)
            {
                <div class="field">
                    <label>@Loc["home.yourName"]</label>
                    <input type="text" @bind="joinName" placeholder="@NamePlaceholder" />
                </div>
                <button class="btn btn-primary btn-block" @onclick="Join" disabled="@busy">@Loc["home.join.button"]</button>
            }
            else
            {
                <p class="faint" style="margin:.2rem 0 .8rem;">@Loc["home.displayHint"]</p>
                <button class="btn btn-gold btn-block" @onclick="OpenDisplay" disabled="@busy">@Loc["home.openDisplay"]</button>
            }
            @if (error is not null)
            {
                <p style="color:var(--danger);margin-top:.6rem;">@error</p>
            }
            @if (lastCode is not null)
            {
                <hr style="border-color:var(--panel-border);margin:1rem 0;" />
                <button class="btn btn-ghost btn-block" @onclick="ResumeLast">
                    @Loc["home.resume"] · <span class="codechip" style="font-size:.9rem;">@lastCode</span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? Code { get; set; }

    private enum View { Landing, Create, Join }
    private View view = View.Landing;
    private enum JoinMode { Player, Display }
    private JoinMode joinAs = JoinMode.Player;

    private string sessionName = "Twilight Imperium";
    private string hostName = "";
    private string joinCode = "";
    private string joinName = "";
    private bool pok = true, codex = true, te = true;
    private bool busy;
    private string? error;
    private string? lastCode;

    private string NamePlaceholder => Loc["players.you"];

    protected override async Task OnInitializedAsync()
    {
        await Store.InitAsync();
        lastCode = await Store.GetLastCodeAsync();
        // Arrived via an invite link (/join/{code}) → jump straight to the pre-filled join form.
        if (!string.IsNullOrWhiteSpace(Code))
        {
            joinCode = Code.Trim().ToUpperInvariant();
            view = View.Join;
        }
    }

    private Expansion SelectedExpansions =>
        Expansion.Base
        | (pok ? Expansion.ProphecyOfKings : 0)
        | (codex ? Expansion.Codex : 0)
        | (te ? Expansion.ThundersEdge : 0);

    private async Task Create()
    {
        busy = true; error = null;
        try
        {
            var req = new CreateSessionRequest(sessionName, Loc.Lang, SelectedExpansions,
                string.IsNullOrWhiteSpace(hostName) ? "Host" : hostName, null, null, null);
            var s = await Store.CreateAsync(req);
            if (s is not null) Nav.NavigateTo($"/s/{s.JoinCode}");
        }
        finally { busy = false; }
    }

    private async Task Join()
    {
        busy = true; error = null;
        try
        {
            var code = joinCode.Trim().ToUpperInvariant();
            if (string.IsNullOrWhiteSpace(code)) return;
            var s = await Store.JoinAsync(code, new JoinSessionRequest(
                string.IsNullOrWhiteSpace(joinName) ? "Player" : joinName, null, null, null));
            if (s is null) { error = Loc["home.notfound"]; return; }
            Nav.NavigateTo($"/s/{s.JoinCode}");
        }
        finally { busy = false; }
    }

    // Open the entered code on this device as the shared wall display (no player join).
    private void OpenDisplay()
    {
        var code = joinCode.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(code)) { error = Loc["home.notfound"]; return; }
        Nav.NavigateTo($"/display/{code}");
    }

    private void ResumeLast()
    {
        if (lastCode is not null) Nav.NavigateTo($"/s/{lastCode}");
    }
}
