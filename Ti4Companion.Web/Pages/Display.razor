@page "/display/{Code}"
@layout EmptyLayout
@inherits Ti4ComponentBase

@if (Store.Session is null || Store.Content is null)
{
    <div class="beamer"><div class="b-title">@(_notFound ? Loc["home.notfound"] : Loc["common.loading"])</div></div>
}
else
{
    var s = Store.Session;
    var ordered = s.Players.OrderBy(p => p.Initiative ?? int.MaxValue).ThenBy(p => p.SeatOrder).ToList();
    var activeCard = s.ActiveStrategyCardId is int id ? Store.Card(id) : null;
    var agenda = Store.Agenda(s.CurrentAgendaId);
    var isAgenda = s.Phase == GamePhase.Agenda;
    const string badge = "clamp(1.8rem, 4.2vh, 4.5rem)";

    <div class="beamer">
        <div class="b-head">
            <div class="b-title">@s.Name</div>
            <div class="b-meta">@Loc["turn.round"] @s.CurrentRound · <span class="b-phase">@Loc[$"phase.{s.Phase}"]</span></div>
            <div class="spacer" style="flex:1"></div>
            @* Prominent join code so players can join straight off the wall. *@
            <div class="b-join">
                <span class="b-join-lbl">@Loc["common.code"]</span>
                <span class="b-join-code">@s.JoinCode</span>
                <span class="dot @(Store.Connected ? "on" : "off")"></span>
            </div>
        </div>

        @if (isAgenda && s.DisplayMode != DisplayMode.Statistics)
        {
            @* Agenda phase: the agenda + a portrait per player with their votes above and influence below. *@
            var elect = agenda is null ? ElectType.ForAgainst : AgendaDisplay.ElectKind(agenda);
            <div class="agenda-stage">
                @if (agenda is null)
                {
                    <div class="agenda-headline">@Loc["agenda.title"]</div>
                    <div class="agenda-kind">@Loc["agenda.waitingForHost"]</div>
                }
                else
                {
                    <div>
                        <span class="agenda-kind chip @(agenda.Type == AgendaType.Law ? "chip-active" : "")">@Loc[agenda.Type == AgendaType.Law ? "agenda.law" : "agenda.directive"]</span>
                    </div>
                    <div class="agenda-headline">@Loc.Pick(agenda.Name, agenda.NameDe)</div>
                    <div class="agenda-body">@Loc.Pick(agenda.Text, agenda.TextDe)</div>

                    @if (s.AgendaVotesHidden)
                    {
                        <div class="agenda-elect">@Loc["agenda.hidden"]</div>
                    }
                    else if (elect == ElectType.ForAgainst)
                    {
                        var forVotes = s.AgendaVotes.Where(v => v.Locked && v.Outcome == VoteOutcome.For).Sum(v => v.Votes);
                        var againstVotes = s.AgendaVotes.Where(v => v.Locked && v.Outcome == VoteOutcome.Against).Sum(v => v.Votes);
                        <div class="tally-row">
                            <span class="tally @(forVotes >= againstVotes && forVotes > 0 ? "lead" : "")" style="color:#8fe0bd;">@Loc["agenda.for"]: @forVotes</span>
                            <span class="tally @(againstVotes > forVotes ? "lead" : "")" style="color:#f1a3ae;">@Loc["agenda.against"]: @againstVotes</span>
                        </div>
                    }
                    else
                    {
                        @* Elect agendas: tally locked votes per chosen candidate, leader highlighted. *@
                        var tally = s.AgendaVotes.Where(v => v.Locked && !string.IsNullOrEmpty(v.Choice) && v.Votes > 0)
                            .GroupBy(v => v.Choice!).Select(g => (Choice: g.Key, Votes: g.Sum(v => v.Votes)))
                            .OrderByDescending(t => t.Votes).ToList();
                        var lead = tally.FirstOrDefault().Votes;
                        <div class="agenda-elect"><b>@Loc["agenda.elect"]:</b> @agenda.Elect</div>
                        <div class="tally-row">
                            @foreach (var t in tally)
                            {
                                <span class="tally @(t.Votes == lead ? "lead" : "")">@ChoiceLabel(agenda, t.Choice): @t.Votes</span>
                            }
                            @if (tally.Count == 0) { <span class="agenda-kind">@Loc["agenda.noVotes"]</span> }
                        </div>
                    }
                }

                @* Result (display only): once all votes are in and revealed — passed / rejected / tie. *@
                @{ var result = AgendaResult(s, agenda, elect); }
                @if (result is not null)
                {
                    <div class="agenda-result">@result</div>
                }

                @* Portraits arranged in a shallow arc (galactic-council feel); middle seats sit highest. *@
                <div class="votes-grid">
                    @{ var order = Store.AgendaOrder(); var vn = order.Count; }
                    @for (var vi = 0; vi < vn; vi++)
                    {
                        var p = order[vi];
                        var t = vn <= 1 ? 0.5 : (double)vi / (vn - 1);
                        var lift = (int)Math.Round(Math.Sin(t * Math.PI) * 7); // 0 at the ends, ~7vh in the middle
                        var vote = s.AgendaVotes.FirstOrDefault(v => v.PlayerId == p.Id);
                        var isSpeaker = s.SpeakerPlayerId == p.Id;
                        var locked = vote?.Locked == true;
                        <div class="vote-card @(isSpeaker ? "speaker-row" : "")" style="--player-color:@p.ColorHex;transform:translateY(-@(lift)vh);">
                            <div class="vote-top">
                                @if (agenda is null)
                                {
                                    @* Influence-entry stage: no votes yet. *@
                                }
                                else if (s.AgendaVotesHidden)
                                {
                                    <span class="vote-choice">@(locked ? "✓ " + Loc["agenda.voted"] : Loc["agenda.waiting"])</span>
                                }
                                else if (!locked)
                                {
                                    <span class="vote-choice waiting">@Loc["agenda.waiting"]</span>
                                }
                                else if (vote!.Outcome == VoteOutcome.Abstain)
                                {
                                    <span class="vote-choice">@Loc["agenda.abstain"]</span>
                                }
                                else
                                {
                                    <span class="vote-weight">@vote.Votes @Loc["agenda.votes"]</span>
                                    <span class="vote-choice @(elect == ElectType.ForAgainst ? (vote.Outcome == VoteOutcome.For ? "v-for" : "v-against") : "")">@VoteLabel(agenda, elect, vote)</span>
                                }
                            </div>
                            <FactionPortrait Player="p" Faction="Store.Faction(p.FactionId)" Speaker="isSpeaker" />
                            <span class="vote-influence"><img class="vi-ico" src="symbols/influence.png" alt="" />@p.Influence</span>
                        </div>
                    }
                </div>
            </div>
        }
        else if (s.DisplayMode == DisplayMode.Statistics)
        {
            @* End-game statistics wall (set only by the host "End game" action) — timing breakdown with charts.
               Left: per-round bar chart + per-phase pie. Right: per-player pie. *@
            var roundItems = _stats.Rounds
                .Select(r => ($"{Loc["stats.round"]} {r.Round}", MatchStats.Format(r.Duration), r.Duration.TotalSeconds, "#d9b04a"))
                .ToList();
            var phaseItems = PhaseOrder.Where(ph => _stats.PhaseTotals.ContainsKey(ph))
                .Select(ph => (Loc[$"phase.{ph}"], MatchStats.Format(_stats.PhaseTotals[ph]), _stats.PhaseTotals[ph].TotalSeconds, PhaseColor(ph)))
                .ToList();
            var playerItems = s.Players.OrderByDescending(p => PlayerTime(p.Id))
                .Select(p => (p.Name, MatchStats.Format(PlayerTime(p.Id)), PlayerTime(p.Id).TotalSeconds, p.ColorHex))
                .ToList();
            <div class="beamer-stats">
                <div class="bs-head-row">
                    <div class="bs-title">@Loc["stats.title"]</div>
                    <div class="bs-match"><span class="bs-lbl">@Loc["stats.match"]</span><span class="bs-big">@MatchStats.Format(_stats.Match ?? TimeSpan.Zero)</span></div>
                </div>
                <div class="bs-cols">
                    <div class="bs-left">
                        <div class="panel bs-panel">
                            <h3>@Loc["stats.perRound"]</h3>
                            <BarChart Items="roundItems" />
                        </div>
                        <div class="panel bs-panel">
                            <h3>@Loc["stats.perPhase"]</h3>
                            <PieChart Items="phaseItems" />
                        </div>
                    </div>
                    <div class="panel bs-panel bs-right">
                        <h3>@Loc["stats.perPlayer"]</h3>
                        <PieChart Items="playerItems" />
                    </div>
                </div>
            </div>
        }
        else
        {
            var mode = s.DisplayMode;
            // All three modes share a left "player table" (Bereich 1); the right panel (Bereich 2) differs.
            // Objectives right panel: split by stage; collapse to one (half-width) column until a Stage II.
            var objStage2 = mode == DisplayMode.Objectives ? s.Objectives.Where(o => Store.Objective(o.ObjectiveId)?.Stage == ObjectiveStage.StageII).ToList() : new();
            var objStage1 = mode == DisplayMode.Objectives ? s.Objectives.Where(o => Store.Objective(o.ObjectiveId)?.Stage != ObjectiveStage.StageII).ToList() : new();
            var objSingle = mode == DisplayMode.Objectives && objStage2.Count == 0;
            var objRows = Math.Max(Math.Max(objStage1.Count, objStage2.Count), 1);
            // Tech right panel: every UNIQUE researched tech across all players (shown once), grouped by colour.
            var allResearched = mode != DisplayMode.Tech ? new List<TechnologyDto>()
                : ordered.SelectMany(p => p.TechnologyIds).Distinct().Select(id => Store.Tech(id)).Where(t => t is not null).Select(t => t!)
                    .OrderBy(t => t.Color).ThenBy(t => t.Prerequisites.Length).ThenBy(t => Loc.Pick(t.Name, t.NameDe)).ToList();
            // Secondary right panel: every still-available (un-exhausted) strategy card (once), by initiative.
            var availCards = mode != DisplayMode.Secondary ? new List<StrategyCardDto>()
                : ordered.SelectMany(p => p.StrategyCards.Where(c => !c.IsExhausted)).Select(c => Store.Card(c.StrategyCardId)).Where(c => c is not null).Select(c => c!)
                    .DistinctBy(c => c.Id).OrderBy(c => c.Initiative).ToList();

            // One tech tile: the full card, a compact name (shown when JS collapses it), and the researcher
            // markers (always shown). data-prereqs drives the collapse order (fewest prerequisites first).
            RenderFragment<TechnologyDto> techItem = t =>
                @<div class="tech-item" data-prereqs="@t.Prerequisites.Length">
                    <TechCard Tech="t" />
                    <span class="ti-name"><TechIcon Color="t.Color" Size="14" /> <span class="ti-label">@Loc.Pick(t.Name, t.NameDe)</span></span>
                    <div class="tech-markers">
                        @foreach (var p in ordered.Where(pl => pl.TechnologyIds.Contains(t.Id)))
                        {
                            <FactionBadge Faction="Store.Faction(p.FactionId)" SizeCss="clamp(1rem, 2.1vh, 1.9rem)" Ring="@p.ColorHex" />
                        }
                    </div>
                </div>;

            @if (activeCard is not null)
            {
                @* A strategy action is being played → enlarge that card and show its ability text. *@
                <div class="highlight-band">
                    <div class="big-strat" style="--c:@activeCard.ColorHex">
                        <div class="strat-head">
                            <span class="num">@activeCard.Initiative</span>
                            <span class="sname">@Loc.Pick(activeCard.Name, activeCard.NameDe)</span>
                            @{ var owner = ordered.FirstOrDefault(p => p.StrategyCards.Any(c => c.StrategyCardId == activeCard.Id)); }
                            @if (owner is not null) { <span class="b-meta">— @owner.Name</span> }
                        </div>
                        <div class="ability-label"><b>@Loc["turn.primary"]</b></div>
                        <ul class="ability-bullets">
                            @foreach (var line in Lines(Loc.Pick(activeCard.PrimaryText, activeCard.PrimaryTextDe))) { <li>@line</li> }
                        </ul>
                        <div class="ability-label sec"><b>@Loc["turn.secondary"]</b></div>
                        <ul class="ability-bullets">
                            @foreach (var line in Lines(Loc.Pick(activeCard.SecondaryText, activeCard.SecondaryTextDe))) { <li>@line</li> }
                        </ul>
                    </div>
                </div>
            }

            <div class="beamer-grid two-area @(mode == DisplayMode.Objectives && objSingle ? "obj-single" : "")">
                @* ===== Bereich 1 — player table (left, content-width). One row per player: initiative ·
                   faction symbol · name+speaker / faction name · strategy card(s) · [tech names, tech mode]. ===== *@
                <div class="panel players-panel">
                    <h3 style="color:var(--gold);">@Loc["nav.players"]</h3>
                    <div class="panel-body">
                        <div class="ptable">
                            @foreach (var p in ordered)
                            {
                                var fac = Store.Faction(p.FactionId);
                                var isActive = s.ActivePlayerId == p.Id;
                                var isSpeaker = s.SpeakerPlayerId == p.Id;
                                <div class="ptr @(isActive ? "active" : "") @(p.HasPassed ? "passed" : "")" style="--player-color:@p.ColorHex">
                                    <span class="ptr-init">@(p.Initiative?.ToString() ?? "—")</span>
                                    <span class="ptr-badge"><FactionBadge Faction="fac" SizeCss="@badge" Ring="@p.ColorHex" /></span>
                                    <div class="ptr-id">
                                        <div class="p-name">@p.Name @if (isSpeaker) { <span class="p-flag speaker" title='@Loc["players.speaker"]'><SpeakerIcon SizeCss="1.2em" /></span> }</div>
                                        <div class="p-fac">@(fac is null ? "—" : Loc.Pick(fac.Name, fac.NameDe))</div>
                                        <div class="p-flags">
                                            @if (s.Phase == GamePhase.Setup)
                                            {
                                                <span class="p-flag @(p.IsReady ? "ready" : "waiting")">@(p.IsReady ? Loc["setup.ready"] : Loc["setup.notReady"])</span>
                                            }
                                            else if (p.HasPassed)
                                            {
                                                <span class="p-flag passed">@Loc["turn.passed"]</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="ptr-strat">
                                        @foreach (var pc in p.StrategyCards.OrderBy(c => c.StrategyCardId))
                                        {
                                            var card = Store.Card(pc.StrategyCardId);
                                            if (card is not null)
                                            {
                                                <span class="s-pill @(pc.IsExhausted ? "used" : "")" style="--c:@card.ColorHex"><span class="pn">@card.Initiative</span> @Loc.Pick(card.Name, card.NameDe)</span>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* ===== Bereich 2 — right content panel: objectives list / all researched techs as cards /
                   all available strategy-card secondaries. Deduplicated, independent of the player table. ===== *@
                <div class="panel content-panel">
                    @if (mode == DisplayMode.Objectives)
                    {
                        <h3 style="color:var(--gold);">@Loc["obj.title"]</h3>
                        @if (s.Objectives.Count == 0)
                        {
                            <div class="panel-body"><p class="muted">@Loc["obj.none"]</p></div>
                        }
                        else
                        {
                            @* Stage I (+ custom) left, Stage II right; --obj-rows drives a uniform card height. *@
                            <div class="panel-body obj-list @(objSingle ? "one" : "two")" style="--obj-rows:@objRows">
                                <div class="obj-col">
                                    @foreach (var so in objStage1) { <ObjectiveDisplayCard So="so" /> }
                                </div>
                                @if (!objSingle)
                                {
                                    <div class="obj-col">
                                        @foreach (var so in objStage2) { <ObjectiveDisplayCard So="so" /> }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (mode == DisplayMode.Tech)
                    {
                        <h3 style="color:var(--gold);">@Loc["tech.title"]</h3>
                        @if (allResearched.Count == 0)
                        {
                            <div class="panel-body"><p class="muted">—</p></div>
                        }
                        else
                        {
                            @* One column per tech colour (full control-tab cards, sorted by prerequisite count);
                               UNIT techs in their own same-width area below. Each card keeps a fixed aspect ratio.
                               When a column lacks vertical space, its low-prerequisite techs collapse to a name
                               first (top-down, one at a time, via ti4.fitTechCols) until it fits. *@
                            var unitTechs = allResearched.Where(t => t.Color == TechColor.Unit).OrderBy(t => t.Prerequisites.Length).ToList();
                            var presentColors = new[] { TechColor.Biotic, TechColor.Propulsion, TechColor.Cybernetic, TechColor.Warfare }
                                .Where(c => allResearched.Any(t => t.Color == c)).ToList();
                            <div class="panel-body tech-cols-wrap" style="--tech-cols:@Math.Max(1, presentColors.Count)">
                                <div class="tech-color-row">
                                    @foreach (var col in presentColors)
                                    {
                                        var colorTechs = allResearched.Where(t => t.Color == col).OrderBy(t => t.Prerequisites.Length).ThenBy(t => Loc.Pick(t.Name, t.NameDe)).ToList();
                                        <div class="tech-col">
                                            @foreach (var t in colorTechs) { @techItem(t) }
                                        </div>
                                    }
                                </div>
                                @if (unitTechs.Count > 0)
                                {
                                    <div class="tech-unit-row">
                                        @foreach (var t in unitTechs) { @techItem(t) }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <h3 style="color:var(--gold);">@Loc["turn.secondary"]</h3>
                        <div class="panel-body sec-cards-panel">
                            @if (availCards.Count == 0) { <p class="muted">—</p> }
                            else
                            {
                                @foreach (var card in availCards)
                                {
                                    <div class="sec-card" style="--c:@card.ColorHex">
                                        <span class="sec-name"><span class="pn">@card.Initiative</span> @Loc.Pick(card.Name, card.NameDe)</span>
                                        <ul class="ability-bullets">@foreach (var line in Lines(Loc.Pick(card.SecondaryText, card.SecondaryTextDe))) { <li>@line</li> }</ul>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Code { get; set; } = "";
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool _notFound;

    // End-game statistics (loaded from the log when the wall enters Statistics mode).
    private IReadOnlyList<SessionLogEntryDto> _log = Array.Empty<SessionLogEntryDto>();
    private MatchStats _stats = new();
    private bool _statsLoaded;
    private static readonly GamePhase[] PhaseOrder = { GamePhase.Strategy, GamePhase.Action, GamePhase.Status, GamePhase.Agenda };
    private TimeSpan PlayerTime(Guid id) => _stats.PerPlayer.TryGetValue(id, out var t) ? t : TimeSpan.Zero;

    protected override async Task OnParametersSetAsync()
    {
        if (Store.Session?.JoinCode == Code.ToUpperInvariant()) return;
        await Store.InitAsync();
        _notFound = !await Store.ConnectAsync(Code.ToUpperInvariant());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var s = Store.Session;
        if (s is null) return;

        // Statistics wall: load the log once on entering the mode, then compute the timing breakdown.
        // Takes precedence over the agenda view (End game can be pressed in any phase).
        if (s.DisplayMode == DisplayMode.Statistics)
        {
            if (!_statsLoaded)
            {
                _statsLoaded = true;
                _log = await Store.Api.GetLogAsync(s.JoinCode);
                _stats = MatchStats.Compute(_log, DateTimeOffset.UtcNow);
                StateHasChanged();
            }
            return;
        }
        _statsLoaded = false; // reload next time stats mode is entered

        // Tech wall: flow the cards into columns; collapse low-prerequisite techs to names per column until
        // each fits (re-evaluated fresh each render, so removing techs re-expands the cards).
        if (s.DisplayMode == DisplayMode.Tech && s.Phase != GamePhase.Agenda)
        {
            // First decide which cards collapse to a name (column pressure), then grow each survivor's font
            // to the largest scale that keeps its name on one line and its description from overflowing.
            try
            {
                await JS.InvokeVoidAsync("ti4.fitTechCols");
                await JS.InvokeVoidAsync("ti4.fitTechCardFonts");
            }
            catch { /* JS not available yet (e.g. prerender) */ }
        }
    }

    private static string[] Lines(string text) => (text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string PhaseColor(GamePhase ph) => ph switch
    {
        GamePhase.Strategy => "#4a78d6",
        GamePhase.Action => "#d6534a",
        GamePhase.Status => "#46c08a",
        GamePhase.Agenda => "#d9b04a",
        _ => "#9aa7c0",
    };

    // Compute the agenda outcome for the wall — only once everyone has locked and (for a face-down vote)
    // the host has revealed. For/Against → passed / rejected / tie (speaker decides); elect → winner / tie.
    private string? AgendaResult(SessionStateDto s, AgendaDto? agenda, ElectType elect)
    {
        if (agenda is null || s.AgendaVotesHidden) return null;
        var allLocked = s.Players.Count > 0 && s.Players.All(p => s.AgendaVotes.Any(v => v.PlayerId == p.Id && v.Locked));
        if (!allLocked) return null;
        if (elect == ElectType.ForAgainst)
        {
            var f = s.AgendaVotes.Where(v => v.Locked && v.Outcome == VoteOutcome.For).Sum(v => v.Votes);
            var a = s.AgendaVotes.Where(v => v.Locked && v.Outcome == VoteOutcome.Against).Sum(v => v.Votes);
            if (f == 0 && a == 0) return Loc["agenda.speakerDecides"];
            if (f == a) return Loc["agenda.speakerDecides"];
            return f > a ? Loc["agenda.passed"] : Loc["agenda.rejected"];
        }
        var tally = s.AgendaVotes.Where(v => v.Locked && !string.IsNullOrEmpty(v.Choice) && v.Votes > 0)
            .GroupBy(v => v.Choice!).Select(g => (Choice: g.Key, Votes: g.Sum(v => v.Votes)))
            .OrderByDescending(t => t.Votes).ToList();
        if (tally.Count == 0) return null;
        if (tally.Count > 1 && tally[0].Votes == tally[1].Votes) return Loc["agenda.speakerDecides"];
        return $"{Loc["agenda.elected"]}: {ChoiceLabel(agenda, tally[0].Choice)}";
    }

    // Resolve a per-player vote into a human label for the display.
    private string VoteLabel(AgendaDto agenda, ElectType elect, AgendaVoteDto vote)
        => elect == ElectType.ForAgainst
            ? Loc[vote.Outcome == VoteOutcome.For ? "agenda.for" : "agenda.against"]
            : ChoiceLabel(agenda, vote.Choice);

    // Resolve an elected candidate key (player id / planet / card number / law / objective) to a label.
    private string ChoiceLabel(AgendaDto agenda, string? choice)
        => AgendaDisplay.ChoiceLabel(Store, Loc, agenda, choice);
}
