@page "/display/{Code}"
@layout EmptyLayout
@inherits Ti4ComponentBase

@if (Store.Session is null || Store.Content is null)
{
    <div class="beamer"><div class="b-title">@Loc["common.loading"]</div></div>
}
else
{
    var s = Store.Session;
    var ordered = s.Players.OrderBy(p => p.Initiative ?? int.MaxValue).ThenBy(p => p.SeatOrder).ToList();
    var activeCard = s.ActiveStrategyCardId is int id ? Store.Card(id) : null;
    var agenda = Store.Agenda(s.CurrentAgendaId);
    var isAgenda = s.Phase == GamePhase.Agenda;
    const string badge = "clamp(1.8rem, 4.2vh, 4.5rem)";

    <div class="beamer">
        <div class="b-head">
            <div class="b-title">@s.Name</div>
            <div class="b-meta">@Loc["turn.round"] @s.CurrentRound · <span class="b-phase">@Loc[$"phase.{s.Phase}"]</span></div>
            <div class="spacer" style="flex:1"></div>
            <div class="b-meta"><span class="dot @(Store.Connected ? "on" : "off")"></span> @s.JoinCode</div>
        </div>

        @if (isAgenda)
        {
            @* Agenda phase: show ONLY the agenda and the votes — nothing else. *@
            <div class="agenda-stage">
                @if (agenda is null)
                {
                    <div class="agenda-headline">@Loc["agenda.title"]</div>
                    <div class="agenda-kind">@Loc["agenda.none"]</div>
                }
                else
                {
                    var elect = AgendaDisplay.ElectKind(agenda);
                    <div>
                        <span class="agenda-kind chip @(agenda.Type == AgendaType.Law ? "chip-active" : "")">@Loc[agenda.Type == AgendaType.Law ? "agenda.law" : "agenda.directive"]</span>
                    </div>
                    <div class="agenda-headline">@Loc.Pick(agenda.Name, agenda.NameDe)</div>
                    <div class="agenda-body">@Loc.Pick(agenda.Text, agenda.TextDe)</div>

                    @if (s.AgendaVotesHidden)
                    {
                        <div class="agenda-elect">@Loc["agenda.hidden"]</div>
                    }
                    else if (elect == ElectType.ForAgainst)
                    {
                        var forVotes = s.AgendaVotes.Where(v => v.Outcome == VoteOutcome.For).Sum(v => v.Votes);
                        var againstVotes = s.AgendaVotes.Where(v => v.Outcome == VoteOutcome.Against).Sum(v => v.Votes);
                        <div class="tally-row">
                            <span class="tally @(forVotes >= againstVotes && forVotes > 0 ? "lead" : "")" style="color:#8fe0bd;">@Loc["agenda.for"]: @forVotes</span>
                            <span class="tally @(againstVotes > forVotes ? "lead" : "")" style="color:#f1a3ae;">@Loc["agenda.against"]: @againstVotes</span>
                        </div>
                    }
                    else
                    {
                        @* Elect agendas: tally votes per chosen candidate, leader highlighted. *@
                        var tally = s.AgendaVotes.Where(v => !string.IsNullOrEmpty(v.Choice) && v.Votes > 0)
                            .GroupBy(v => v.Choice!).Select(g => (Choice: g.Key, Votes: g.Sum(v => v.Votes)))
                            .OrderByDescending(t => t.Votes).ToList();
                        var lead = tally.FirstOrDefault().Votes;
                        <div class="agenda-elect"><b>@Loc["agenda.elect"]:</b> @agenda.Elect</div>
                        <div class="tally-row">
                            @foreach (var t in tally)
                            {
                                <span class="tally @(t.Votes == lead ? "lead" : "")">@ChoiceLabel(agenda, t.Choice): @t.Votes</span>
                            }
                            @if (tally.Count == 0) { <span class="agenda-kind">@Loc["agenda.noVotes"]</span> }
                        </div>
                    }

                    <div class="votes-grid">
                        @foreach (var p in Store.AgendaOrder())
                        {
                            var vote = s.AgendaVotes.FirstOrDefault(v => v.PlayerId == p.Id);
                            var isSpeaker = s.SpeakerPlayerId == p.Id;
                            <div class="vote-card @(isSpeaker ? "speaker-row" : "")" style="--player-color:@p.ColorHex">
                                <FactionBadge Faction="Store.Faction(p.FactionId)" SizeCss="@badge" Ring="@p.ColorHex" />
                                <span class="vote-name">@p.Name @if (isSpeaker) { <span class="spk">★</span> }</span>
                                @if (s.AgendaVotesHidden)
                                {
                                    var voted = vote is not null && vote.Outcome != VoteOutcome.Abstain;
                                    <span class="vote-choice">@(voted ? "✓ " + Loc["agenda.voted"] : Loc["agenda.waiting"])</span>
                                }
                                else if (vote is null || vote.Outcome == VoteOutcome.Abstain)
                                {
                                    <span class="vote-choice">@Loc["agenda.abstain"]</span>
                                }
                                else
                                {
                                    <span class="vote-choice">@VoteLabel(agenda, elect, vote)</span>
                                    <span class="vote-weight">@vote.Votes</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            var mode = s.DisplayMode;
            // Tech mode: full cards when there's room, else fall back to compact names.
            var maxTechs = ordered.Count == 0 ? 0 : ordered.Max(p => p.TechnologyIds.Count);
            var techCompact = ordered.Count > 6 || maxTechs > 8;

            @if (activeCard is not null)
            {
                @* A strategy action is being played → enlarge that card and show its ability text. *@
                <div class="highlight-band">
                    <div class="big-strat" style="--c:@activeCard.ColorHex">
                        <div class="strat-head">
                            <span class="num">@activeCard.Initiative</span>
                            <span class="sname">@Loc.Pick(activeCard.Name, activeCard.NameDe)</span>
                            @{ var owner = ordered.FirstOrDefault(p => p.StrategyCards.Any(c => c.StrategyCardId == activeCard.Id)); }
                            @if (owner is not null) { <span class="b-meta">— @owner.Name</span> }
                        </div>
                        <div class="ability-label"><b>@Loc["turn.primary"]</b></div>
                        <ul class="ability-bullets">
                            @foreach (var line in Lines(Loc.Pick(activeCard.PrimaryText, activeCard.PrimaryTextDe))) { <li>@line</li> }
                        </ul>
                        <div class="ability-label sec"><b>@Loc["turn.secondary"]</b></div>
                        <ul class="ability-bullets">
                            @foreach (var line in Lines(Loc.Pick(activeCard.SecondaryText, activeCard.SecondaryTextDe))) { <li>@line</li> }
                        </ul>
                    </div>
                </div>
            }

            <div class="beamer-grid @(mode == DisplayMode.Objectives ? "two-col" : "one-col")">
                <div class="panel">
                    <h3 style="color:var(--gold);">@Loc["nav.players"]@(mode == DisplayMode.Secondary ? " · " + Loc["turn.secondary"] : mode == DisplayMode.Tech ? " · " + Loc["tech.title"] : "")</h3>
                    <div class="panel-body">
                        @foreach (var p in ordered)
                        {
                            var fac = Store.Faction(p.FactionId);
                            var isActive = s.ActivePlayerId == p.Id;
                            var nonExhausted = p.StrategyCards.Where(c => !c.IsExhausted).Select(c => Store.Card(c.StrategyCardId)).Where(c => c is not null).Select(c => c!).OrderBy(c => c.Initiative).ToList();
                            var techs = p.TechnologyIds.Select(t => Store.Tech(t)).Where(t => t is not null).Select(t => t!).OrderBy(t => t.Color).ThenBy(t => t.Prerequisites.Length).ToList();
                            <div class="p-block @(mode == DisplayMode.Objectives ? "" : "wide") @(isActive ? "active" : "") @(p.HasPassed ? "passed" : "")" style="--player-color:@p.ColorHex">
                                <div class="p-row">
                                    <span class="p-init">@(p.Initiative?.ToString() ?? "—")</span>
                                    <FactionBadge Faction="fac" SizeCss="@badge" Ring="@p.ColorHex" />
                                    <div class="p-id">
                                        <div class="p-name">@p.Name</div>
                                        <div class="p-fac">@(fac is null ? "—" : Loc.Pick(fac.Name, fac.NameDe))</div>
                                    </div>

                                    <div class="p-content @(mode == DisplayMode.Secondary ? "sec" : mode == DisplayMode.Tech ? "tech" : "")">
                                        @if (mode == DisplayMode.Objectives)
                                        {
                                            @foreach (var pc in p.StrategyCards.OrderBy(c => c.StrategyCardId))
                                            {
                                                var card = Store.Card(pc.StrategyCardId);
                                                if (card is not null)
                                                {
                                                    <span class="s-pill @(pc.IsExhausted ? "used" : "")" style="--c:@card.ColorHex"><span class="pn">@card.Initiative</span> @Loc.Pick(card.Name, card.NameDe)</span>
                                                }
                                            }
                                        }
                                        else if (mode == DisplayMode.Secondary)
                                        {
                                            @foreach (var card in nonExhausted)
                                            {
                                                <div class="sec-card" style="--c:@card.ColorHex">
                                                    <span class="sec-name"><span class="pn">@card.Initiative</span> @Loc.Pick(card.Name, card.NameDe)</span>
                                                    <ul class="ability-bullets">@foreach (var line in Lines(Loc.Pick(card.SecondaryText, card.SecondaryTextDe))) { <li>@line</li> }</ul>
                                                </div>
                                            }
                                        }
                                        else if (mode == DisplayMode.Tech)
                                        {
                                            @if (techs.Count == 0) { <span class="faint">—</span> }
                                            else if (techCompact)
                                            {
                                                @foreach (var t in techs) { <span class="my-tech" style="border-color:@TechHex(t.Color)"><TechIcon Color="t.Color" Size="14" /> @Loc.Pick(t.Name, t.NameDe)</span> }
                                            }
                                            else
                                            {
                                                @foreach (var t in techs) { <TechCard Tech="t" /> }
                                            }
                                        }
                                    </div>

                                    <div class="p-flags">
                                        @if (s.Phase == GamePhase.Setup)
                                        {
                                            <span class="p-flag @(p.IsReady ? "ready" : "waiting")">@(p.IsReady ? Loc["setup.ready"] : Loc["setup.notReady"])</span>
                                        }
                                        else if (p.HasPassed)
                                        {
                                            <span class="p-flag passed">@Loc["turn.passed"]</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (mode == DisplayMode.Objectives)
                {
                    <div class="panel">
                        <h3 style="color:var(--gold);">@Loc["obj.title"]</h3>
                        <div class="panel-body obj-list">
                            @if (s.Objectives.Count == 0)
                            {
                                <p class="muted">@Loc["obj.none"]</p>
                            }
                            @foreach (var so in s.Objectives)
                            {
                                var def = so.CustomName is null ? Store.Objective(so.ObjectiveId) : null;
                                var custom = so.CustomName is not null;
                                var stage2 = def?.Stage == ObjectiveStage.StageII;
                                var name = so.CustomName ?? (def is null ? so.ObjectiveId : Loc.Pick(def.Name, def.NameDe));
                                var pts = so.CustomPoints ?? def?.Points;
                                <div class="obj-card @(custom ? "secret" : stage2 ? "stage2" : "stage1")">
                                    <div class="obj-head">
                                        <span class="obj-name">@name</span>
                                        <span class="obj-vp">@pts</span>
                                    </div>
                                    @if (def is not null) { <div class="obj-req">@Loc.Pick(def.Requirement, def.RequirementDe)</div> }
                                    <div class="obj-markers">
                                        @foreach (var pid in so.ScoredByPlayerIds)
                                        {
                                            var pl = s.Players.FirstOrDefault(x => x.Id == pid);
                                            if (pl is not null) { <FactionBadge Faction="Store.Faction(pl.FactionId)" SizeCss="clamp(1.4rem,3vh,3rem)" Ring="@pl.ColorHex" /> }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Code { get; set; } = "";

    protected override async Task OnParametersSetAsync()
    {
        if (Store.Session?.JoinCode == Code.ToUpperInvariant()) return;
        await Store.InitAsync();
        await Store.ConnectAsync(Code.ToUpperInvariant());
    }

    private static string[] Lines(string text) => (text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string TechHex(TechColor c) => c switch
    {
        TechColor.Biotic => "#4caf50",
        TechColor.Propulsion => "#4a78d6",
        TechColor.Cybernetic => "#e0c341",
        TechColor.Warfare => "#d6534a",
        _ => "#9aa7c0",
    };

    // Resolve a per-player vote into a human label for the display.
    private string VoteLabel(AgendaDto agenda, ElectType elect, AgendaVoteDto vote)
        => elect == ElectType.ForAgainst
            ? Loc[vote.Outcome == VoteOutcome.For ? "agenda.for" : "agenda.against"]
            : ChoiceLabel(agenda, vote.Choice);

    // Resolve an elected candidate key (player id / planet / card number / law / objective) to a label.
    private string ChoiceLabel(AgendaDto agenda, string? choice)
        => AgendaDisplay.ChoiceLabel(Store, Loc, agenda, choice);
}
