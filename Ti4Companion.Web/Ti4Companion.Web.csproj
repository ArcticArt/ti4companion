<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- This hosted app is published and served as plain static files (UseBlazorFrameworkFiles +
         UseStaticFiles behind Apache), NOT via MapStaticAssets — so the .NET 9+ fingerprint import map
         is never populated at runtime and the boot chain (dotnet.js etc.) 404s. Disable fingerprinting
         so the framework files keep stable names that resolve without an import map. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <!-- QR codes for joining, generated in the browser. Deliberately NOT an online generator (the invite
         URL would leak to a third party and the wall must work offline on LAN), and deliberately this
         package rather than QRCoder: it is a dependency-free managed port of Nayuki's generator, whereas
         QRCoder drags in System.Drawing.Common / SkiaSharp, which have no business in a WASM payload. -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.1.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ti4Companion.Shared\Ti4Companion.Shared.csproj" />
  </ItemGroup>

</Project>
