@inherits LayoutComponentBase
@implements IDisposable
@inject Loc Loc
@inject SessionStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="appbar">
    @if (Store.Session is { } s)
    {
        @* In a session the bar carries round + phase, the join code + invite link, who you are, and the
           language toggle (the session-name / beamer button are no longer needed here). *@
        <div class="ab-meta">
            <span class="ab-round">@Loc["turn.round"] @s.CurrentRound</span>
            <span class="ab-phase">@Loc[$"phase.{s.Phase}"]</span>
        </div>
        @* Code + invite are the host's to share — players don't need them (joiners read the code off the wall). *@
        @if (Store.IsHost)
        {
            <span class="codechip ab-code" @onclick="CopyCode" title='@Loc["common.copy"]'>@s.JoinCode</span>
            <button class="btn btn-sm btn-ghost" @onclick="CopyInvite" title='@Loc["nav.invite"]'>@(inviteCopied ? "✓" : "🔗")</button>
            <button class="btn btn-sm btn-ghost" @onclick="() => showStats = true" title='@Loc["stats.button"]'>📊</button>
            @if (codeCopied || inviteCopied) { <span class="chip chip-done">@Loc["common.copied"]</span> }
        }
        <div class="spacer"></div>
        @if (Store.Me is { } me)
        {
            <FactionBadge Faction="Store.Faction(me.FactionId)" Size="2" Ring="@me.ColorHex" />
            <span class="ab-name">@me.Name</span>
        }
        <span class="dot @(Store.Connected ? "on" : "off")" title="@(Store.Connected ? "live" : Loc["common.connecting"])"></span>
        <button class="btn btn-sm" @onclick="ToggleLang" title="EN / DE">@(Loc.Lang == Language.En ? "EN" : "DE")</button>
        <button class="btn btn-sm btn-ghost" @onclick="Leave" title='@Loc["nav.leave"]'>✕</button>
    }
    else
    {
        <a class="brand" href="/">@Loc["app.title"]<small>@Loc["app.subtitle"]</small></a>
        <div class="spacer"></div>
        <button class="btn btn-sm" @onclick="ToggleLang" title="EN / DE">@(Loc.Lang == Language.En ? "EN" : "DE")</button>
    }
</div>

<div class="content">
    @Body
</div>

@* Legal notice + credits. Free, non-commercial fan project; rights holders + data sources linked. *@
<footer class="legal-footer">
    <p>@Loc["legal.disclaimer"]</p>
    <p>@Loc["legal.copyright"]</p>
    <p>@Loc["legal.noncommercial"]</p>
    <p class="legal-meta">
        <a href="https://www.asmodee.com" target="_blank" rel="noopener noreferrer">Asmodee</a> ·
        <a href="https://www.fantasyflightgames.com" target="_blank" rel="noopener noreferrer">Fantasy Flight Games</a>
    </p>
    <p class="legal-meta">
        @Loc["legal.thanks"]:
        <a href="https://ti4lookup.com" target="_blank" rel="noopener noreferrer">ti4lookup.com</a> ·
        <a href="https://twilight-imperium.fandom.com" target="_blank" rel="noopener noreferrer">TI4 Wiki (Fandom)</a> ·
        <a href="https://boardgamegeek.com/filepage/180049/ti4-race-and-tech-symbols-vectorized" target="_blank" rel="noopener noreferrer">TI4 Race &amp; Tech Symbols (BGG)</a>
    </p>
</footer>

@if (showStats && Store.Session is not null)
{
    <MatchStatsModal OnClose="CloseStats" />
}

@code {
    private bool showStats;
    private void CloseStats() { showStats = false; StateHasChanged(); }

    protected override void OnInitialized()
    {
        Loc.OnChange += Changed;
        Store.OnChange += Changed;
    }

    private void Changed() => InvokeAsync(StateHasChanged);

    private void ToggleLang() => Loc.SetLanguage(Loc.Lang == Language.En ? Language.De : Language.En);

    private bool codeCopied, inviteCopied;

    private async Task CopyCode()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Store.Session!.JoinCode); codeCopied = true; inviteCopied = false; }
        catch { }
    }

    private async Task CopyInvite()
    {
        var url = $"{Nav.BaseUri}join/{Store.Session!.JoinCode}";
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", url); inviteCopied = true; codeCopied = false; }
        catch { }
    }

    private async Task Leave()
    {
        var ok = await JS.InvokeAsync<bool>("confirm", Loc["nav.leaveConfirm"]);
        if (!ok) return;
        await Store.LeaveAsync();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Loc.OnChange -= Changed;
        Store.OnChange -= Changed;
    }
}
