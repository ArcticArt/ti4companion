@inherits LayoutComponentBase
@implements IDisposable
@inject Loc Loc
@inject SessionStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS

<InstanceBadge />
@* A deploy landed while this page was open (or between two visits): offer the reload that actually picks the
   new version up. Not on `/display` — that uses EmptyLayout, and a wall nobody stands at cannot tap a bar;
   the wall is reloaded from the device that runs the table. *@
<UpdateNotice />
<div class="app-shell">
<div class="appbar">
    @if (Store.Session is { } s)
    {
        @* In a session the bar carries round + phase, the join code + invite link, who you are, and the
           language toggle (the session-name / beamer button are no longer needed here). *@
        <div class="ab-meta">
            <span class="ab-round">@Loc["turn.round"] @s.CurrentRound</span>
            <span class="ab-phase">@Loc[$"phase.{s.Phase}"]</span>
        </div>
        @* Code + invite are the host's to share — players don't need them (joiners read the code off the wall). *@
        @if (Store.IsHost)
        {
            <span class="codechip ab-code" @onclick="CopyCode" title='@Loc["common.copy"]'>@s.JoinCode</span>
            <button class="btn btn-sm btn-ghost" @onclick="CopyInvite" title='@Loc["nav.invite"]'><MaterialIcon Name="@(inviteCopied ? "check" : "link")" /></button>
            @* A real link, not window.open via interop: popup blockers (and Safari, once an awaited
               interop roundtrip has expired the gesture) would swallow a scripted open. *@
            <a class="btn btn-sm btn-ghost" href="@($"/display/{s.JoinCode}")" target="_blank" rel="noopener" title='@Loc["nav.openDisplay"]'><MaterialIcon Name="open_in_new" /></a>
            <button class="btn btn-sm btn-ghost" @onclick="() => showQr = true" title='@Loc["nav.joinQr"]'><MaterialIcon Name="qr_code" /></button>
            <button class="btn btn-sm btn-ghost" @onclick="() => showStats = true" title='@Loc["stats.button"]'><StatIcon /></button>
            <button class="btn btn-sm btn-ghost" @onclick="Pause" title='@Loc["pause.pause"]'><MaterialIcon Name="pause" /></button>
        <button class="btn btn-sm btn-danger ab-endgame" @onclick="EndGame" title='@Loc["turn.endGame"]'>@Loc["turn.endGame"]</button>
            @if (codeCopied || inviteCopied) { <span class="chip chip-done">@Loc["common.copied"]</span> }
        }
        <div class="spacer"></div>
        @if (Store.Me is { } me)
        {
            <FactionBadge Faction="Store.Faction(me.FactionId)" Size="2" Ring="@me.ColorHex" />
            <span class="ab-name">@me.Name</span>
        }
        @* Per-device notification switch — every player wants it for their own phone, not just the host. *@
        <PushToggle />
        <span class="dot @(Store.Connected ? "on" : "off")" title="@(Store.Connected ? "live" : Loc["common.connecting"])"></span>
        <button class="btn btn-sm" @onclick="ToggleLang" title="EN / DE">@(Loc.Lang == Language.En ? "EN" : "DE")</button>
        <button class="btn btn-sm btn-ghost" @onclick="Leave" title='@Loc["nav.leave"]'><MaterialIcon Name="close" /></button>
    }
    else
    {
        @* No brand here: outside a session the title stands large over the start page itself (see Home). *@
        <div class="spacer"></div>
        <button class="btn btn-sm" @onclick="ToggleLang" title="EN / DE">@(Loc.Lang == Language.En ? "EN" : "DE")</button>
    }
</div>

<div class="content">
    @Body
</div>

@* Legal notice + credits. Free, non-commercial fan project; rights holders + data sources linked. *@
<footer class="legal-footer">
    <p>@Loc["legal.disclaimer"]</p>
    <p>@Loc["legal.copyrightPre"]<a href="https://www.asmodee.com" target="_blank" rel="noopener noreferrer">Asmodee North America, Inc.</a> (<a href="https://www.fantasyflightgames.com" target="_blank" rel="noopener noreferrer">Fantasy Flight Games</a>)@Loc["legal.copyrightPost"]</p>
    <p>@Loc["legal.noncommercial"]</p>
    <p class="legal-meta">
        @Loc["legal.createdBy"] <a href="https://frostforge.studio" target="_blank" rel="noopener noreferrer">FrostForgeStudio</a> · @Loc["legal.contact"]
        <a href="mailto:Frostforgestudio@proton.me">Frostforgestudio@proton.me</a>
        · ♥ @Loc["legal.donate"] <a href="https://www.paypal.me/Frostforgestudio" target="_blank" rel="noopener noreferrer">PayPal</a>
    </p>
    <p class="legal-meta">
        @Loc["legal.thanks"]:
        <a href="https://ti4lookup.com" target="_blank" rel="noopener noreferrer">ti4lookup.com</a> ·
        <a href="https://twilight-imperium.fandom.com" target="_blank" rel="noopener noreferrer">TI4 Wiki (Fandom)</a> ·
        <a href="https://boardgamegeek.com/filepage/180049/ti4-race-and-tech-symbols-vectorized" target="_blank" rel="noopener noreferrer">TI4 Race &amp; Tech Symbols (BGG)</a> ·
        @* Apache 2.0 requires attribution when the icons are redistributed — see MaterialIcon.razor. *@
        <a href="https://github.com/google/material-design-icons" target="_blank" rel="noopener noreferrer">Google Material Symbols (Apache 2.0)</a>
    </p>
</footer>
</div>

@if (showStats && Store.Session is not null)
{
    <MatchStatsModal OnClose="CloseStats" EndGame="endGame" OnArchived="Archived" />
}

@* Join QR for the people at the table — hold the phone up instead of dictating the code. *@
@if (showQr && Store.Session is { } qs)
{
    @* In this app `.modal-backdrop` is the overlay and `.modal` the box — bootstrap.min.css also defines
       `.modal` (position:fixed, top/left 0), so using it as the overlay pins it to the corner. *@
    <div class="modal-backdrop centered blurred" @onclick="() => showQr = false">
        @* Same card as the wall's QR area — the session name, the URL to type if scanning fails, and the
           code. It used to be a generic "scan to join this session" hint, which told a phone holder less
           than the link itself does. *@
        <div class="modal qr-box" @onclick:stopPropagation="true">
            <div class="qr-title">@string.Format(Loc["nav.joinQrTitle"], qs.Name)</div>
            <div class="qr-url">@InviteLink(qs.JoinCode)</div>
            <JoinQr Text="@InviteLink(qs.JoinCode)" SizeCss="min(72vw, 20rem)" Alt="@Loc["nav.joinQr"]" />
            <div class="qr-code-big">@qs.JoinCode</div>
            <button class="btn" @onclick="() => showQr = false">@Loc["common.close"]</button>
        </div>
    </div>
}

@* The secondary round of a strategy action. In the shell, not in the action view: it opens when a turn is
   ended and has to be visible whatever tab the device happens to be on. It shows itself only to the people
   it concerns (see SecondaryModal). *@
@if (Store.Session is not null)
{
    <SecondaryModal />
    @* "Record what you researched", after a Technology action — every device, its own seat, and the clock
       stands still until the table is done. In the shell for the same reason as the secondary round: it is
       raised by somebody else's action. *@
    <TechPromptModal />
    @* Red Tape Lite's purge / random-removal questions. Same reason they live in the shell: they are raised by
       a phase change or by somebody else pulling a tape, so they must show whatever tab this device is on. *@
    <RedTapeModal />
}

@* Pause overlay — blocks all input while the game is paused; only the host can resume. *@
@if (Store.Session is { Paused: true })
{
    <div class="pause-overlay">
        <div class="pause-box">
            <div class="pause-icon"><MaterialIcon Name="pause" SizeCss="1em" /></div>
            <div class="pause-title">@Loc["pause.title"]</div>
            @if (Store.IsHost)
            {
                <button class="btn btn-gold btn-lg" @onclick="Resume"><MaterialIcon Name="play_arrow" /> @Loc["pause.resume"]</button>
            }
            else
            {
                <div class="faint">@Loc["pause.waiting"]</div>
            }
        </div>
    </div>
}

@code {
    private bool showStats;
    private bool showQr;
    private bool endGame;
    private void CloseStats() { showStats = false; endGame = false; StateHasChanged(); }

    // The match was archived: with the session deleted there is nothing left to look at, so leave. After a
    // reset the same session is sitting in setup again — stay on it.
    private async Task Archived(bool deleted)
    {
        showStats = false;
        endGame = false;
        if (deleted)
        {
            // Deleted for good, so it must not linger in the start page's "resume" list either.
            var code = Store.Session?.JoinCode;
            await Store.LeaveAsync();
            if (code is not null) await Store.ForgetRecentAsync(code);
            Nav.NavigateTo("/");
            return;
        }
        await Store.RefreshAsync();
        StateHasChanged();
    }

    // Same URL the "copy invite link" button produces, so the QR works on a LAN address too.
    private string InviteLink(string joinCode) => $"{Nav.BaseUri}join/{joinCode}";

    protected override void OnInitialized()
    {
        Loc.OnChange += Changed;
        Store.OnChange += Changed;
    }

    private void Changed() => InvokeAsync(StateHasChanged);

    private void ToggleLang() => Loc.SetLanguage(Loc.Lang == Language.En ? Language.De : Language.En);

    private bool codeCopied, inviteCopied;

    // Copy must run SYNCHRONOUSLY inside the click gesture: Safari (iPad!) rejects clipboard writes
    // once the gesture has expired, which the normal awaited interop roundtrip triggers — the old
    // async version silently did nothing there. In Blazor WASM the runtime is in-process, so the
    // cast to IJSInProcessRuntime always succeeds; ti4.copyText also falls back to the legacy
    // execCommand path where navigator.clipboard doesn't exist (plain-HTTP LAN play).
    private bool CopySync(string text)
    {
        try { return ((IJSInProcessRuntime)JS).Invoke<bool>("ti4.copyText", text); }
        catch { return false; }
    }

    private void CopyCode()
    {
        if (CopySync(Store.Session!.JoinCode)) { codeCopied = true; inviteCopied = false; }
    }

    private void CopyInvite()
    {
        if (CopySync($"{Nav.BaseUri}join/{Store.Session!.JoinCode}")) { inviteCopied = true; codeCopied = false; }
    }

    private async Task Leave()
    {
        var ok = await JS.InvokeAsync<bool>("confirm", Loc["nav.leaveConfirm"]);
        if (!ok) return;
        await Store.LeaveAsync();
        Nav.NavigateTo("/");
    }

    private Task Pause() => Store.Session is null ? Task.CompletedTask : Store.Mutate(Store.Api.PauseGameAsync(Store.Session.Id));
    private Task Resume() => Store.Session is null ? Task.CompletedTask : Store.Mutate(Store.Api.ResumeGameAsync(Store.Session.Id));

    // End the match: bring the statistics onto the wall display and open the end-of-match dialog (the stats
    // with the three ways out). No confirm() first — the dialog IS the question, and its own buttons say what
    // each one does, which a yes/no box never could.
    private async Task EndGame()
    {
        if (Store.Session is null) return;
        // Keep a permanent record of the match before anything else — the session itself is wiped once
        // its retention window passes, and this is the moment the host declares the game finished.
        try { await Store.Api.RecordSummaryAsync(Store.Session.Id); } catch { }
        await Store.Mutate(Store.Api.SetDisplayModeAsync(Store.Session.Id, DisplayMode.Statistics));
        endGame = true;
        showStats = true;
        StateHasChanged();
    }

    public void Dispose()
    {
        Loc.OnChange -= Changed;
        Store.OnChange -= Changed;
    }
}
