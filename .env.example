# Copy to ".env" and adjust. Never commit the real .env.

# PostgreSQL credentials (the database name is fixed to "ti4db").
POSTGRES_USER=ti4admin
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# Public address served by Caddy.
#  - A domain enables automatic HTTPS via Let's Encrypt (point its DNS A/AAAA record at the server first):
#      SITE_ADDRESS=ti4.example.com
#  - Or ":80" to serve plain HTTP while testing against the server IP:
SITE_ADDRESS=:80
